---
import BaseLayout from '../layouts/BaseLayout.astro';
import { completedProjects, getProjectHref } from '../content/projects';

interface Props {
  slug: string;
  category: string;
}

const { slug, category } = Astro.props;
const project = completedProjects.find((item) => item.slug === slug);

if (!project) {
  throw new Error(`Unknown completed project: ${slug}`);
}

const canonicalUrl = `https://www.antelle.com${getProjectHref(project)}`;
const description = `${project.title} completed project placeholder for Antelle IT Ltd.`;
const iconRoot = '/assets/images/icons/completed-projects';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  url: canonicalUrl,
  description
};
---

<BaseLayout
  title={`${project.title} | Antelle IT Ltd`}
  description={description}
  pageClass="experience project"
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <div class="container project-content">
    <section class="project-header row">
      <div class="col-12">
        <a class="back-control" href="/experience/completed-projects/">
          <span class="back-arrow" aria-hidden="true">&larr;</span>
          <span>Back to all completed projects</span>
        </a>
        <h1>{project.title}</h1>
        <p class="header-text light">{project.summary}</p>
      </div>
    </section>

    <section class="row">
      <div class="col-12 col-md-6">
        <h2 class="project-section-heading">
          <img src={`${iconRoot}/project-brief.svg`} alt="" aria-hidden="true" />
          Project Brief
        </h2>
        <p>
          This page has been added as a placeholder for a completed {category} project. The final wording should confirm
          the client context, business problem, scope and measurable outcome before publication.
        </p>
        <p>
          <span class="owner-note">[OWNER INPUT REQUIRED: confirm project brief and whether this page should be public.]</span>
        </p>
      </div>
      <div class="col-12 col-md-6">
        <h2 class="project-section-heading">
          <img src={`${iconRoot}/solution-implemented.svg`} alt="" aria-hidden="true" />
          Our Solution
        </h2>
        <p>
          Antelle's role, technical approach and delivery responsibilities are to be confirmed. Final copy should remain
          factual, avoid naming clients unless approved, and describe the practical business value delivered.
        </p>
        <p>
          <span class="owner-note">[OWNER INPUT REQUIRED: confirm solution summary, technologies and support model.]</span>
        </p>
      </div>
    </section>

    <section class="services-provided row">
      <div class="col-12">
        <h2>Services Provided</h2>
        <ul>
          <li>
            <img class="icon-img" src={`${iconRoot}/analysis-design.svg`} alt="" aria-hidden="true" />
            <span>Requirements review and scope confirmation</span>
          </li>
          <li>
            <img class="icon-img" src={`${iconRoot}/development.svg`} alt="" aria-hidden="true" />
            <span>Solution design and technical delivery</span>
          </li>
          <li>
            <img class="icon-img" src={`${iconRoot}/jigsaw-integration.svg`} alt="" aria-hidden="true" />
            <span>Integration, data or workflow support where applicable</span>
          </li>
          <li>
            <img class="icon-img" src={`${iconRoot}/project-management.svg`} alt="" aria-hidden="true" />
            <span>Testing, handover and post-delivery support</span>
          </li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .owner-note {
    background: #fff59d;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
  }

  .project-header a.back-control {
    align-items: center;
    background: #0072bc;
    border: 2px solid #0072bc;
    border-radius: 3px;
    box-shadow: 0 6px 14px rgba(52, 64, 75, 0.12);
    color: #ffffff;
    display: inline-flex;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding: 0.7rem 1rem;
    text-align: left;
  }

  .project-header a.back-control:hover,
  .project-header a.back-control:focus {
    background: rgba(0, 114, 188, 0.75);
    border-color: transparent;
    color: #ffffff;
  }

  .project-header a.back-control .nc-icon {
    margin-right: 0;
  }

  .project-header a.back-control .back-arrow {
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (max-width: 576px) {
    .project-header a.back-control {
      width: 100%;
    }
  }

  .project-section-heading {
    align-items: center;
    display: flex;
    gap: 0.75rem;
  }

  .project-section-heading img {
    height: 2.5rem;
    width: 2.5rem;
  }

  .services-provided .icon-img {
    flex: 0 0 2.5rem;
    height: 2.5rem;
    margin-right: 0;
    vertical-align: middle;
    width: 2.5rem;
  }

  .services-provided ul {
    column-count: initial !important;
    column-gap: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding-left: 0;
  }

  .services-provided li {
    align-items: center;
    display: grid !important;
    gap: 1.25rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 4rem;
    padding: 1rem 0;
  }

  .services-provided li::before {
    content: none !important;
    display: none !important;
  }

  @media (min-width: 992px) {
    .project-content {
      max-width: 960px;
    }
  }

  @media (max-width: 576px) {
    .services-provided ul {
      display: block;
    }
  }
</style>
