---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMirrorPage, getMirrorPageSlugs } from '../lib/mirror-pages';

export function getStaticPaths() {
  return getMirrorPageSlugs().map((slug) => ({
    params: { slug },
    props: { page: getMirrorPage(slug) }
  }));
}

const { page } = Astro.props;
---

<BaseLayout title={page.title} description={page.description} pageClass={page.pageClass}>
  <div class="container" set:html={page.content} />
</BaseLayout>

<style is:global>
  .experience.project .project-section-icon {
    height: 2rem;
    width: 2rem;
  }

  .experience.project .project-content .icon-img {
    flex: 0 0 2.5rem;
    height: 2.5rem;
    margin-right: 0;
    vertical-align: middle;
    width: 2.5rem;
  }

  @media (min-width: 992px) {
    .experience.project .project-content.row > [class*='col-lg-8'],
    .experience.project .project-content.row > [class*='col-xl-8'] {
      flex: 0 0 83.333333%;
      max-width: 83.333333%;
    }
  }

  @media (min-width: 1200px) {
    .experience.project .project-content.row > [class*='col-xl-8'] {
      flex: 0 0 75%;
      max-width: 75%;
    }
  }

  .experience.project .project-content section.services-provided ul {
    column-count: initial !important;
    column-gap: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding-left: 0;
  }

  .experience.project .project-content section.services-provided ul li {
    align-items: center;
    break-inside: avoid;
    display: grid !important;
    gap: 1.25rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 4rem;
  }

  .experience.project .project-content section.services-provided ul li::before {
    content: none !important;
    display: none !important;
  }

  @media (max-width: 576px) {
    .experience.project .project-content section.services-provided ul {
      display: block;
    }
  }

  .experience.project .project-header a.back-control {
    align-items: center;
    background: #0072bc;
    border: 2px solid #0072bc;
    border-radius: 3px;
    box-shadow: 0 6px 14px rgba(52, 64, 75, 0.12);
    color: #ffffff;
    display: inline-flex;
    font-family: 'UniversNextPro-Bold', arial, sans-serif;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding: 0.7rem 1rem;
    text-align: left;
  }

  .experience.project .project-header a.back-control:hover,
  .experience.project .project-header a.back-control:focus {
    background: rgba(0, 114, 188, 0.75);
    border-color: transparent;
    color: #ffffff;
  }

  .experience.project .project-header a.back-control .nc-icon {
    margin-right: 0;
  }

  .experience.project .project-header a.back-control .back-arrow {
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (max-width: 576px) {
    .experience.project .project-header a.back-control {
      width: 100%;
    }
  }
</style>
