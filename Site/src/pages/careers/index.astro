---
import BaseLayout from '../../layouts/BaseLayout.astro';

const asset = (path: string) => `/assets/${path}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/careers/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Douglas',
    addressRegion: 'Isle of Man',
    postalCode: 'IM4 4RG',
    streetAddress: 'Unit 17b, Carrs Lane, Tromode Estate'
  },
  description:
    'Careers information for Antelle IT Ltd, an Isle of Man software consultancy.'
};
---

<BaseLayout
  title="Careers | Antelle IT Ltd"
  description="Careers at Antelle IT Ltd. We currently have no vacancies, but are happy to retain CVs on file should a suitable position arise."
  pageClass="careers"
  canonicalUrl="https://www.antelle.com/careers/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-careers-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Careers</h1>
        <p class="header-text light">
          We do not currently have any vacancies, but we are always happy to hear from capable people who may be a good
          fit for future opportunities.
        </p>
        <a href="/contact/" class="cta cta-large">Send Us Your Details</a>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <img
          class="img-splash img-fluid careers-hero"
          src={asset('images/heroes/splash-careers.svg')}
          alt="Career planning graphic"
        />
      </div>
    </section>

    <section class="sector row vacancies-section" id="current-vacancies">
      <div class="col-12">
        <h2>Current Vacancies</h2>
      </div>
      <div class="col-12">
        <article class="vacancy-status">
          <span class="status-label">Recruitment Status</span>
          <h3 class="header-2-text light">No current vacancies.</h3>
          <p>
            We are not actively recruiting at the moment. When suitable roles become available, we will update this page
            with clear details about the position, skills required and how to apply.
          </p>
        </article>
      </div>
      <div class="col-12">
        <article class="future-opportunities">
          <h3>Speculative Applications</h3>
          <p>
            We are happy to retain CVs on file should a suitable position arise in future. Please get in touch with a
            brief note about the type of work you are interested in and attach your CV.
          </p>
          <p>
            We will keep speculative CVs for up to 12 months, unless you ask us to delete your details sooner. After
            that period, we will securely delete your CV unless we contact you and you agree that we may retain it for
            longer.
          </p>
          <p>
            By sending us your CV, you agree that Antelle may use your details to assess potential future roles. You can
            ask us to delete your details at any time by contacting <a href="mailto:hello@antelle.com">hello@antelle.com</a>.
          </p>
          <a href="/contact/" class="cta">Send Us Your Details</a>
        </article>
      </div>
    </section>

    <section class="sector row" id="working-with-antelle">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Working With Antelle</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <circle class="visual-dark" cx="20" cy="24" r="10" />
            <circle class="visual-accent" cx="44" cy="24" r="10" />
            <path class="visual-line" d="M12 51c4-9 11-14 20-14s16 5 20 14" />
          </svg>
          <h4>Small Team</h4>
          <p>
            We are a focused team, so people tend to work close to the client problem and see the impact of what they
            build.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <rect class="visual-panel" x="8" y="12" width="48" height="40" rx="5" />
            <path class="visual-line" d="M17 25h30M17 36h21" />
            <path class="visual-tick" d="M39 43l6 6 12-16" />
          </svg>
          <h4>Practical Delivery</h4>
          <p>
            Our work is grounded in maintainable software, Microsoft technology, integration, reporting and long-term
            support.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <path class="visual-dark" d="M32 7l22 9v13c0 14-9 25-22 29C19 54 10 43 10 29V16l22-9Z" />
            <path class="visual-tick" d="M22 32l7 7 15-18" />
          </svg>
          <h4>Client Trust</h4>
          <p>
            We value clear communication, responsible advice and careful handling of systems that matter to client
            operations.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .careers-hero,
  .content-icon {
    display: block;
    height: auto;
  }

  .careers-hero {
    width: 100%;
  }

  .content-icon {
    height: 4rem;
    margin-bottom: 1rem;
    width: 4rem;
  }

  .vacancies-section {
    align-items: stretch;
    padding-bottom: 2rem;
  }

  .vacancies-section h2 {
    margin-bottom: 1.5rem;
  }

  .vacancy-status,
  .future-opportunities {
    height: 100%;
    margin-bottom: 1.5rem;
    max-width: 58rem;
  }

  .vacancy-status {
    background: rgba(141, 216, 248, 0.18);
    border-left: 6px solid #0072bc;
    padding: 2rem;
  }

  .vacancy-status .status-label {
    color: #0072bc;
    display: block;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
    letter-spacing: 0;
    margin-bottom: 1rem;
    text-transform: uppercase;
  }

  .vacancy-status p:last-child,
  .future-opportunities p:last-of-type {
    margin-bottom: 0;
  }

  .future-opportunities {
    background: #ffffff;
    box-shadow: 0 8px 14px 0 rgba(52, 64, 75, 0.12);
    padding: 2rem;
  }

  #working-with-antelle {
    padding-top: 2rem;
  }

  .future-opportunities h3 {
    color: #0072bc;
    margin-bottom: 1.5rem;
  }

  .future-opportunities .cta {
    margin-top: 1rem;
  }

  .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .visual-accent {
    fill: #8dd8f8;
  }

  .visual-mid {
    fill: #00baf2;
  }

  .visual-dark {
    fill: #0072bc;
  }

  .owner-note {
    background: #fff59d;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (max-width: 991.98px) {
    section.maintained-careers-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-careers-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-careers-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .careers-hero {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-careers-splash .header-text {
      font-size: 1.6em;
    }

    section.maintained-careers-splash .cta {
      min-width: 0;
      width: 100%;
    }

    .careers-hero {
      max-width: 13rem;
      width: 50%;
    }

    .vacancy-status,
    .future-opportunities {
      padding: 1.5rem;
    }

  }
</style>
