---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { completedProjects as projectEntries, getProjectHref } from '../../../content/projects';
import { services } from '../../../content/services';
import { outstandingItems } from '../../../data/outstandingItems';

type SiteMapNode = {
  title: string;
  href?: string;
  complete?: boolean;
  children?: SiteMapNode[];
};

const statusSymbol = (complete?: boolean) => (complete ? '\u2713' : '\u00d7');

const recentProjects: SiteMapNode[] = projectEntries.filter((project) => project.collection === 'recent').map((project) => ({
  title: project.title,
  href: getProjectHref(project),
  complete: true
}));

const earlierProjects: SiteMapNode[] = projectEntries.filter((project) => project.collection === 'earlier').map((project) => ({
  title: project.title,
  href: getProjectHref(project),
  complete: true
}));

const completedProjectGroups: SiteMapNode[] = [
  {
    title: 'Recent Work',
    complete: true,
    children: recentProjects
  },
  {
    title: 'Earlier Work',
    complete: true,
    children: earlierProjects
  }
];

const completedServicePaths = new Set([
  '/services/power-platform/',
  '/services/microsoft-dynamics-crm/',
  '/services/software-development/',
  '/services/web-development/',
  '/services/business-intelligence/',
  '/services/consultancy/'
]);

const nodes: SiteMapNode[] = [
  { title: 'Home', href: '/', complete: true },
  {
    title: 'Services',
    children: services.map((service) => ({
      title: service.title,
      href: service.href,
      complete: completedServicePaths.has(service.href)
    }))
  },
  {
    title: 'Experience',
    children: [
      { title: 'Past Experience', href: '/experience/past-experience/', complete: true },
      { title: 'Core Skills', href: '/experience/core-skills/', complete: true },
      {
        title: 'Completed Projects',
        href: '/experience/completed-projects/',
        complete: true,
        children: completedProjectGroups
      }
    ]
  },
  { title: 'Careers', href: '/careers/', complete: true },
  {
    title: 'About',
    children: [
      { title: 'About Antelle', href: '/about/', complete: true },
      { title: 'Site Map', href: '/about/site-map/' }
    ]
  },
  { title: 'Contact', href: '/contact/' },
  { title: 'Information Security', href: '/informationsecurity/', complete: true },
  { title: 'Privacy Policy', href: '/privacy-policy/', complete: true }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Development Site Map',
  url: 'https://www.antelle.com/dev/site-map/',
  description: 'Development-only sitemap for the Antelle website rebuild.'
};
---

<BaseLayout
  title="Development Site Map | Antelle IT Ltd"
  description="Development-only sitemap for the Antelle website rebuild."
  pageClass="about sitemap-page"
  canonicalUrl="https://www.antelle.com/dev/site-map/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row">
      <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-8">
        <h1 class="subheader-text">Development Site Map</h1>
        <p class="header-text light">
          A development-only view of the rebuilt site structure and page sign-off status.
        </p>
      </div>
    </section>

    <section class="sector row sitemap-status" aria-label="Completion status legend">
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <h2>Rebuild Status</h2>
        <p>
          This page is being used as a temporary visual tool during the rebuild. A tick means the page has been signed
          off. A cross means the page still needs review or further editing.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6 legend">
        <span class="status-pill complete"><span aria-hidden="true">{statusSymbol(true)}</span> Signed off</span>
        <span class="status-pill incomplete"><span aria-hidden="true">{statusSymbol(false)}</span> Needs review</span>
      </div>
    </section>

    <section class="sector row sitemap-tree" id="site-structure">
      <div class="col-12">
        <h2>Site Structure</h2>
        <ul class="site-node-list root-list">
          {
            nodes.map((node) => (
              <li>
                <span class={node.complete ? 'status-icon complete' : 'status-icon incomplete'} aria-label={node.complete ? 'Signed off' : 'Needs review'}>
                  {statusSymbol(node.complete)}
                </span>
                {node.href ? <a href={node.href}>{node.title}</a> : <span class="node-label">{node.title}</span>}
                {node.children && (
                  <ul class="site-node-list">
                    {node.children.map((child) => (
                      <li>
                        <span
                          class={child.complete ? 'status-icon complete' : 'status-icon incomplete'}
                          aria-label={child.complete ? 'Signed off' : 'Needs review'}
                        >
                          {statusSymbol(child.complete)}
                        </span>
                        {child.href ? <a href={child.href}>{child.title}</a> : <span class="node-label">{child.title}</span>}
                        {child.children && (
                          <ul class="site-node-list">
                            {child.children.map((grandchild) => (
                              <li>
                                <span
                                  class={grandchild.complete ? 'status-icon complete' : 'status-icon incomplete'}
                                  aria-label={grandchild.complete ? 'Signed off' : 'Needs review'}
                                >
                                  {statusSymbol(grandchild.complete)}
                                </span>
                                {grandchild.href ? (
                                  <a href={grandchild.href}>{grandchild.title}</a>
                                ) : (
                                  <span class="node-label">{grandchild.title}</span>
                                )}
                                {grandchild.children && (
                                  <ul class="site-node-list">
                                    {grandchild.children.map((greatGrandchild) => (
                                      <li>
                                        <span
                                          class={greatGrandchild.complete ? 'status-icon complete' : 'status-icon incomplete'}
                                          aria-label={greatGrandchild.complete ? 'Signed off' : 'Needs review'}
                                        >
                                          {statusSymbol(greatGrandchild.complete)}
                                        </span>
                                        {greatGrandchild.href ? (
                                          <a href={greatGrandchild.href}>{greatGrandchild.title}</a>
                                        ) : (
                                          <span class="node-label">{greatGrandchild.title}</span>
                                        )}
                                      </li>
                                    ))}
                                  </ul>
                                )}
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="sector row outstanding-items" id="outstanding-items">
      <div class="col-12">
        <h2>Outstanding Items</h2>
        <p>
          Shared checklist for known follow-up work. When an item is resolved, remove it from this table's data source
          and any matching note in the docs.
        </p>
        <div class="outstanding-table-wrap">
          <table class="outstanding-table">
            <thead>
              <tr>
                <th scope="col">Area</th>
                <th scope="col">Item</th>
                <th scope="col">Status</th>
                <th scope="col">Source</th>
                <th scope="col">Note</th>
              </tr>
            </thead>
            <tbody>
              {
                outstandingItems.map((item) => (
                  <tr>
                    <td>{item.area}</td>
                    <td>{item.item}</td>
                    <td><span class="todo-status">{item.status}</span></td>
                    <td>{item.source.startsWith('/') ? <a href={item.source}>{item.source}</a> : <span>{item.source}</span>}</td>
                    <td>{item.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  .sitemap-page .sitemap-status {
    padding-top: 4rem;
  }

  .sitemap-page .legend {
    align-items: flex-start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  .sitemap-page .status-pill {
    align-items: center;
    border: 1px solid rgba(0, 114, 188, 0.2);
    display: inline-flex;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
  }

  .sitemap-page .site-node-list {
    list-style: none;
    margin: 0.75rem 0 0 1.5rem;
    padding: 0;
  }

  .sitemap-page .root-list {
    margin-left: 0;
  }

  .sitemap-page .site-node-list li {
    color: #343f4b;
    margin: 0;
    padding: 0.45rem 0;
  }

  .sitemap-page .site-node-list li::before {
    content: '';
    display: none;
  }

  .sitemap-page .status-icon {
    display: inline-flex;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
    font-size: 1.5em;
    line-height: 1;
    margin-right: 0.75rem;
    width: 1.1em;
  }

  .sitemap-page .complete {
    background: transparent;
    color: #2e7d32;
  }

  .sitemap-page .incomplete {
    background: transparent;
    color: #c62828;
  }

  .sitemap-page .node-label {
    color: #343f4b;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
  }

  .sitemap-page .outstanding-items {
    padding-top: 4rem;
  }

  .sitemap-page .outstanding-table-wrap {
    overflow-x: auto;
  }

  .sitemap-page .outstanding-table {
    border-collapse: collapse;
    min-width: 60rem;
    width: 100%;
  }

  .sitemap-page .outstanding-table th,
  .sitemap-page .outstanding-table td {
    border-bottom: 1px solid rgba(0, 114, 188, 0.2);
    padding: 0.85rem 1rem;
    text-align: left;
    vertical-align: top;
  }

  .sitemap-page .outstanding-table th {
    color: #0072bc;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
  }

  .sitemap-page .todo-status {
    color: #c62828;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
    white-space: nowrap;
  }
</style>


