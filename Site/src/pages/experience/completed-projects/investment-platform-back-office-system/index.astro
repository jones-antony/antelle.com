---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { completedProjects, getProjectHref } from '../../../../content/projects';

const project = completedProjects.find((item) => item.slug === 'investment-platform-back-office-system');

if (!project) {
  throw new Error('Investment Platform Back-Office System project metadata is missing.');
}

const projectHref = getProjectHref(project);
const canonicalUrl = `https://www.antelle.com${projectHref}`;
const description =
  'A Dynamics 365 back-office system supporting investment platform operations, integration, reporting and long-term support.';
const iconRoot = '/assets/images/icons/completed-projects';

const servicesProvided = [
  ['consultancy.svg', 'Consultancy'],
  ['development.svg', 'Development'],
  ['database-design.svg', 'Data Modelling'],
  ['data-conversion.svg', 'Data Conversion'],
  ['jigsaw-integration.svg', 'Systems Integration'],
  ['api-design.svg', 'API Design'],
  ['analysis-design.svg', 'Analysis and System Design'],
  ['project-management.svg', 'Project Management'],
  ['reporting.svg', 'Management Reporting'],
  ['app-modernisation.svg', 'App Modernisation']
];

const technologiesUsed = [
  ['dynamics-crm.svg', 'Microsoft Dynamics CRM'],
  ['dotnet.svg', 'Microsoft .NET Framework'],
  ['csharp.svg', 'Microsoft C# .Net'],
  ['visual-studio.svg', 'Microsoft Visual Studio'],
  ['sql-server.svg', 'Microsoft SQL Server'],
  ['ssis.svg', 'SQL Server Integration Services'],
  ['api.svg', 'Web Service'],
  ['restful-api.svg', 'RESTful API'],
  ['power-bi.svg', 'Microsoft Power BI'],
  ['reporting-services.svg', 'Microsoft Reporting Services'],
  ['custom-controls.svg', 'Custom Controls and Libraries']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  url: canonicalUrl,
  description
};
---

<BaseLayout
  title={`${project.title} | Antelle IT Ltd`}
  description={description}
  pageClass="experience project"
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <div class="container">
    <header class="project-header row">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
        <a href="/experience/completed-projects/" class="back-control project-list-back">
          <span class="back-arrow" aria-hidden="true">&larr;</span>
          <span>Back to all completed projects</span>
        </a>
        <h1 class="display-text light">{project.title}</h1>
        <h2 class="header-2-text light">International investment platform operations</h2>
      </div>
    </header>

    <nav class="navbar subnavbar navbar-expand-sm sticky-top">
      <button
        class="navbar-toggler cta tertiary small"
        type="button"
        aria-controls="navbarSubNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        Toggle SubNavigation
      </button>
      <div class="collapse navbar-collapse" id="navbarSubNav">
        <ul class="navbar-nav">
          <li class="nav-item active">
            <a class="nav-link" href={`${projectHref}#brief`}>
              <img class="project-section-icon" src={`${iconRoot}/project-brief.svg`} alt="" aria-hidden="true" />
              Project Brief
              <span class="sr-only">(current)</span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#solution`}>
              <img class="project-section-icon" src={`${iconRoot}/solution-implemented.svg`} alt="" aria-hidden="true" />
              Solution Implemented
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#services`}>
              <img class="project-section-icon" src={`${iconRoot}/services-provided.svg`} alt="" aria-hidden="true" />
              Services Provided
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#technologies`}>
              <img class="project-section-icon" src={`${iconRoot}/technologies-used.svg`} alt="" aria-hidden="true" />
              Technologies Used
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="project-content row justify-content-center">
      <div class="col-12 col-sm-12 col-md-11 col-lg-10 col-xl-9">
        <section class="project-brief">
          <h3 id="brief">Project Brief</h3>
          <p>
            Antelle has worked with Ardan International, part of the IFGL group of companies, over a multi-year
            partnership to design, build, support and enhance a comprehensive back-office system supporting the operation
            and continued growth of the Ardan investment platform.
          </p>
          <p>
            Ardan operates in a regulated international wealth management environment, supporting financial advisers and
            their clients through a broad investment platform proposition. As the platform grew, Ardan required a robust
            internal back-office system capable of supporting operational control, reducing operational risk and
            providing a reliable source of truth for non-investment related business data.
          </p>
          <p>
            The project was initially focused on internal back-office users, reducing dependency on ageing operational
            systems and supporting the migration of data into a more structured Dynamics 365 environment. Over time, the
            solution has evolved to support wider business processes and integration requirements, including surfacing
            data to Ardan's portal and integrating with the investment platform.
          </p>
          <p>
            Built using Dynamics 365 9.2 on-premises, the system supports operational, compliance, reporting and
            integration requirements across client onboarding, intermediary and IFA hierarchy management, third-party
            records, risk assessment, client screening, management information, regulatory extracts, portal integration
            and investment platform integration.
          </p>
        </section>

        <section class="solution-implemented">
          <h3 id="solution">Solution Implemented</h3>
          <p>
            Antelle designed and delivered a Dynamics 365-based back-office system to support the operational needs of
            Ardan International's investment platform business.
          </p>
          <p>
            The solution provides structured back-office capability across client onboarding, IFA and intermediary
            hierarchy management, third-party administration, risk assessment, client screening, reporting and
            regulatory data extraction. Workflow-enabled processes support key operational activities, particularly
            where business is more complex or where an intermediary chooses not to use the portal route.
          </p>
          <p>
            Dynamics 365 acts as the central operational record for non-investment related data, with integrations
            supporting the wider platform ecosystem. Antelle implemented RESTful APIs to surface relevant CRM data to
            the portal, while also supporting integration with the investment platform itself.
          </p>
          <p>
            The solution also supports scheduled client screening, with screening activity performed each evening.
            Reporting is enabled through aggregated data drawn from both CRM and the investment platform, with Antelle
            collecting and structuring the CRM-side data required for downstream reporting and Power BI analysis.
          </p>
          <p>
            As part of the initial implementation, Antelle provided data migration services to move business information
            from legacy systems into Dynamics 365. This helped establish the CRM system as a reliable operational
            foundation while reducing dependency on ageing back-office technology.
          </p>
          <p>
            The resulting system has supported the growth of the Ardan platform by providing a reliable, integrated and
            well-understood operational backbone for non-investment related business processes. Antelle continues to act
            as a long-term Dynamics 365, integration and support partner.
          </p>
        </section>

        <section class="services-provided">
          <h3 id="services">Services Provided</h3>
          <ul>
            {
              servicesProvided.map(([icon, label]) => (
                <li>
                  <img class="icon-img" src={`${iconRoot}/${icon}`} alt={label} />
                  <span>{label}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="services-provided">
          <h3 id="technologies">Technologies Used</h3>
          <ul>
            {
              technologiesUsed.map(([icon, label]) => (
                <li>
                  <img class="icon-img" src={`${iconRoot}/${icon}`} alt={label} />
                  <span>
                    {label === 'Custom Controls and Libraries' ? (
                      <>
                        Custom Controls and<br />
                        Libraries
                      </>
                    ) : (
                      label
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(.experience.project .project-section-icon) {
    height: 2rem;
    width: 2rem;
  }

  :global(.experience.project .project-content .icon-img) {
    flex: 0 0 2.5rem;
    height: 2.5rem;
    margin-right: 0;
    vertical-align: middle;
    width: 2.5rem;
  }

  :global(.experience.project .project-content .services-provided ul) {
    column-count: initial !important;
    column-gap: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding-left: 0;
  }

  :global(.experience.project .project-content .services-provided li) {
    align-items: center;
    break-inside: avoid;
    display: grid !important;
    gap: 1.25rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 4rem;
  }

  :global(.experience.project .project-content .services-provided li::before) {
    content: none !important;
    display: none !important;
  }

  @media (max-width: 576px) {
    :global(.experience.project .project-content .services-provided ul) {
      display: block;
    }
  }

  :global(.experience.project .project-header a.back-control) {
    align-items: center;
    background: #0072bc;
    border: 2px solid #0072bc;
    border-radius: 3px;
    box-shadow: 0 6px 14px rgba(52, 64, 75, 0.12);
    color: #ffffff;
    display: inline-flex;
    font-family: 'AntelleSans-Bold', arial, sans-serif;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding: 0.7rem 1rem;
    text-align: left;
  }

  :global(.experience.project .project-header a.back-control:hover),
  :global(.experience.project .project-header a.back-control:focus) {
    background: rgba(0, 114, 188, 0.75);
    border-color: transparent;
    color: #ffffff;
  }

  :global(.experience.project .project-header a.back-control .back-arrow) {
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (max-width: 576px) {
    :global(.experience.project .project-header a.back-control) {
      width: 100%;
    }
  }
</style>
