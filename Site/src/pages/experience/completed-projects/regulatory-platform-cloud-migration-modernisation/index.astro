---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { completedProjects, getProjectHref } from '../../../../content/projects';

const project = completedProjects.find(
  (item) => item.slug === 'regulatory-platform-cloud-migration-modernisation'
);

if (!project) {
  throw new Error('Regulatory Platform Cloud Migration & Modernisation project metadata is missing.');
}

const projectHref = getProjectHref(project);
const canonicalUrl = `https://www.antelle.com${projectHref}`;
const description =
  'Migration and modernisation of regulatory management systems from Microsoft Dynamics CRM 8.2 to Microsoft Dataverse in Azure.';
const iconRoot = '/assets/images/icons/completed-projects';

const servicesProvided = [
  ['consultancy.svg', 'Consultancy'],
  ['app-modernisation.svg', 'App Modernisation'],
  ['data-conversion.svg', 'Data Conversion'],
  ['database-design.svg', 'Data Modelling'],
  ['development.svg', 'Development'],
  ['jigsaw-integration.svg', 'Systems Integration'],
  ['api-design.svg', 'API Design'],
  ['analysis-design.svg', 'Analysis and System Design'],
  ['project-management.svg', 'Project Management'],
  ['reporting.svg', 'Management Reporting']
];

const technologiesUsed = [
  ['dynamics-crm.svg', 'Microsoft Dynamics CRM'],
  ['dataverse.svg', 'Microsoft Dataverse'],
  ['power-platform.svg', 'Power Platform'],
  ['power-apps.svg', 'Power Apps'],
  ['ssis.svg', 'SQL Server Integration Services'],
  ['sql-server.svg', 'Microsoft SQL Server'],
  ['dotnet.svg', 'Microsoft .NET Framework'],
  ['csharp.svg', 'Microsoft C# .Net'],
  ['api.svg', 'Web Service'],
  ['restful-api.svg', 'RESTful API'],
  ['custom-controls.svg', 'Custom Controls and Libraries'],
  ['document-management.svg', 'Laserfiche Integration']
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  url: canonicalUrl,
  description
};
---

<BaseLayout
  title={`${project.title} | Antelle IT Ltd`}
  description={description}
  pageClass="experience project"
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
>
  <div class="container">
    <header class="project-header row">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 text-center">
        <a href="/experience/completed-projects/" class="back-control project-list-back">
          <span class="back-arrow" aria-hidden="true">&larr;</span>
          <span>Back to all completed projects</span>
        </a>
        <h1 class="display-text light">{project.title}</h1>
        <h2 class="header-2-text light">Isle of Man regulatory authorities</h2>
      </div>
    </header>

    <nav class="navbar subnavbar navbar-expand-sm sticky-top">
      <button
        class="navbar-toggler cta tertiary small"
        type="button"
        aria-controls="navbarSubNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        Toggle SubNavigation
      </button>
      <div class="collapse navbar-collapse" id="navbarSubNav">
        <ul class="navbar-nav">
          <li class="nav-item active">
            <a class="nav-link" href={`${projectHref}#brief`}>
              <img class="project-section-icon" src={`${iconRoot}/project-brief.svg`} alt="" aria-hidden="true" />
              Project Brief
              <span class="sr-only">(current)</span>
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#solution`}>
              <img
                class="project-section-icon"
                src={`${iconRoot}/solution-implemented.svg`}
                alt=""
                aria-hidden="true"
              />
              Solution Implemented
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#services`}>
              <img class="project-section-icon" src={`${iconRoot}/services-provided.svg`} alt="" aria-hidden="true" />
              Services Provided
            </a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href={`${projectHref}#technologies`}>
              <img class="project-section-icon" src={`${iconRoot}/technologies-used.svg`} alt="" aria-hidden="true" />
              Technologies Used
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <div class="project-content row justify-content-center">
      <div class="col-12 col-sm-12 col-md-11 col-lg-10 col-xl-9">
        <section class="project-brief">
          <h3 id="brief">Project Brief</h3>
          <p>
            Antelle was engaged to migrate the regulatory management systems used by the Isle of Man Financial
            Supervision Authority and Gambling Supervision Commission from Microsoft Dynamics CRM 8.2 to Microsoft
            Dataverse in Azure.
          </p>
          <p>
            The existing systems supported critical day-to-day regulatory operations across both authorities and
            contained several years of regulatory history. The migration therefore needed to be delivered with minimal
            disruption to live operations, while maintaining service continuity, preserving data integrity and reducing
            risk during cutover.
          </p>
          <p>
            The project was driven by strategic, technical and operational objectives, including moving away from ageing
            on-premises infrastructure, reducing platform and licensing risk, improving supportability, modernising the
            legacy code base, improving security, reducing technical debt and creating a stronger foundation for future
            Power Platform and Azure-based development.
          </p>
          <p>
            While the migration was primarily delivered on a like-for-like basis to minimise business change and
            retraining, Antelle also used the programme to refactor and improve selected areas where this provided clear
            operational, technical or cost benefits.
          </p>
        </section>

        <section class="solution-implemented">
          <h3 id="solution">Solution Implemented</h3>
          <p>
            Antelle migrated the existing Dynamics CRM 8.2 regulatory systems to Microsoft Dataverse with model-driven
            Power Apps, maintaining the established shared-solution model used by both regulators. The platform
            continued to operate from a common development approach, with separate UAT and Production environments for
            each authority to preserve organisational separation and independent operational control.
          </p>
          <p>
            A major focus of the programme was data migration and validation. Antelle migrated several years of
            regulatory history from the legacy CRM platform into Dataverse, ensuring that complex regulatory records,
            relationships, audit context and operational continuity were preserved.
          </p>
          <p>
            The migration also included a broad modernisation of the supporting technical estate. Legacy JavaScript,
            plugins, APIs, integrations and related code components were reviewed, updated and refactored where
            appropriate to work effectively within the Dataverse and Power Platform environment.
          </p>
          <p>
            Existing integrations were modernised, including interfaces supporting data warehouse processes, public
            website exports, document generation, reporting and related operational services. Laserfiche integration was
            also significantly enhanced, including improved metadata extraction and direct integration points through
            custom buttons and system hooks.
          </p>
          <p>
            The programme also identified and reworked elements of the solution that had previously depended on Dynamics
            CRM licensing. By redesigning these areas, Antelle helped deliver significant ongoing licence savings while
            maintaining the required business capability.
          </p>
          <p>
            The resulting platform reduced ongoing licence costs, lowered platform risk, improved user experience,
            enhanced Laserfiche integration, reduced technical debt and made future enhancements easier to deliver.
            Antelle continues to provide day-to-day system support, ongoing enhancements, release management,
            environment management and strategic platform roadmap support.
          </p>
        </section>

        <section class="services-provided">
          <h3 id="services">Services Provided</h3>
          <ul>
            {
              servicesProvided.map(([icon, label]) => (
                <li>
                  <img class="icon-img" src={`${iconRoot}/${icon}`} alt={label} />
                  <span>{label}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="services-provided">
          <h3 id="technologies">Technologies Used</h3>
          <ul>
            {
              technologiesUsed.map(([icon, label]) => (
                <li>
                  <img class="icon-img" src={`${iconRoot}/${icon}`} alt={label} />
                  <span>
                    {label === 'Custom Controls and Libraries' ? (
                      <>
                        Custom Controls and<br />
                        Libraries
                      </>
                    ) : (
                      label
                    )}
                  </span>
                </li>
              ))
            }
          </ul>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  :global(.experience.project .project-section-icon) {
    height: 2rem;
    width: 2rem;
  }

  :global(.experience.project .project-content .icon-img) {
    flex: 0 0 2.5rem;
    height: 2.5rem;
    margin-right: 0;
    vertical-align: middle;
    width: 2.5rem;
  }

  :global(.experience.project .project-content .services-provided ul) {
    column-count: initial !important;
    column-gap: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
    padding-left: 0;
  }

  :global(.experience.project .project-content .services-provided li) {
    align-items: center;
    break-inside: avoid;
    display: grid !important;
    gap: 1.25rem;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    min-height: 4rem;
  }

  :global(.experience.project .project-content .services-provided li::before) {
    content: none !important;
    display: none !important;
  }

  :global(.experience.project .project-content .services-provided li span) {
    flex: 1 1 auto;
    min-width: 0;
  }

  @media (max-width: 576px) {
    :global(.experience.project .project-content .services-provided ul) {
      display: block;
    }
  }

  :global(.experience.project .project-header a.back-control) {
    align-items: center;
    background: #0072bc;
    border: 2px solid #0072bc;
    border-radius: 3px;
    box-shadow: 0 6px 14px rgba(52, 64, 75, 0.12);
    color: #ffffff;
    display: inline-flex;
    font-family: 'UniversNextPro-Bold', arial, sans-serif;
    gap: 0.5rem;
    margin: 0 0 2.5rem;
    padding: 0.7rem 1rem;
    text-align: left;
  }

  :global(.experience.project .project-header a.back-control:hover),
  :global(.experience.project .project-header a.back-control:focus) {
    background: rgba(0, 114, 188, 0.75);
    border-color: transparent;
    color: #ffffff;
  }

  :global(.experience.project .project-header a.back-control .nc-icon) {
    margin-right: 0;
  }

  :global(.experience.project .project-header a.back-control .back-arrow) {
    font-size: 1.2rem;
    line-height: 1;
  }

  @media (max-width: 576px) {
    :global(.experience.project .project-header a.back-control) {
      width: 100%;
    }
  }
</style>
