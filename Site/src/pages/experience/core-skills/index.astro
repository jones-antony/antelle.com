---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const primarySkills = [
  {
    icon: 'code',
    title: 'Microsoft .NET and C#',
    text:
      'Bespoke web, service and back-office application development using the Microsoft .NET ecosystem, with an emphasis on maintainable business software.'
  },
  {
    icon: 'database',
    title: 'Microsoft SQL Server and Azure SQL',
    text:
      'Database design, optimisation, migration and operational support for SQL-backed systems, including Azure SQL where it is the right fit.'
  },
  {
    icon: 'power',
    title: 'Power Platform and Dataverse',
    text:
      'Power Apps, Power Automate and Dataverse solutions for process automation, low-code applications and Microsoft platform integration.'
  },
  {
    icon: 'crm',
    title: 'Microsoft Dynamics CRM',
    text:
      'Dynamics CRM and model-driven business systems covering configuration, customisation, integration, upgrade support and long-term administration.'
  },
  {
    icon: 'reporting',
    title: 'Power BI and Reporting',
    text:
      'Operational dashboards, management information and reporting models that help teams understand performance, exceptions and business activity.'
  },
  {
    icon: 'api',
    title: 'Systems Integration and APIs',
    text:
      'Integration between line-of-business systems, portals, data services and Microsoft platforms using practical API and data exchange patterns.'
  }
];

const supportingSkills = [
  'ASP.NET, MVC, Web API and REST services',
  'Data migration and transformation',
  'Office automation and document generation',
  'Legacy Microsoft application support',
  'Crystal Reports and SSRS estates',
  'Hosting, deployment and operational support'
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/experience/core-skills/',
  areaServed: 'Isle of Man',
  description:
    'Core skills from Antelle IT Ltd across Microsoft .NET, SQL Server, Azure SQL, Power Platform, Dataverse, Power BI, Dynamics CRM and integration.'
};
---

<BaseLayout
  title="Core Skills | Antelle IT Ltd"
  description="Antelle IT Ltd core skills across Microsoft .NET, SQL Server, Azure SQL, Power Platform, Dataverse, Power BI, Dynamics CRM and integration."
  pageClass="experience"
  canonicalUrl="https://www.antelle.com/experience/core-skills/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-experience-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Core Skills</h1>
        <p class="header-text light">
          Microsoft technology, data, integration and software delivery skills applied to practical business problems.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg
          class="img-splash img-fluid experience-hero"
          viewBox="0 0 420 260"
          role="img"
          aria-labelledby="skills-hero-title skills-hero-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="skills-hero-title">Core technology skills</title>
          <desc id="skills-hero-desc">A technical skills board showing code, data and reporting blocks.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />
          <rect class="visual-dark" x="70" y="66" width="92" height="42" rx="5" />
          <rect class="visual-accent" x="178" y="66" width="92" height="42" rx="5" />
          <rect class="visual-mid" x="286" y="66" width="62" height="42" rx="5" />
          <path class="visual-line" d="M82 150h82M82 180h130M246 150h84M246 180h58" />
          <circle class="visual-mid" cx="88" cy="88" r="8" />
          <path class="visual-tick" d="M102 88h38M205 88h38M304 88h26" />
        </svg>
      </div>
    </section>

    <section class="sector row" id="overview">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Overview</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <h3 class="header-2-text light">Skills chosen for the problem, not for novelty.</h3>
          <p>
            Our core skills sit around the Microsoft technology stack: bespoke .NET software, SQL Server, Azure SQL,
            Dynamics CRM, Dataverse, Power Apps, Power Automate, Power BI and the wider Azure ecosystem. The focus is on
            choosing technology that fits the workload, the organisation and the long-term support model.
          </p>
          <p>
            That often means combining custom software, low-code applications, reporting and integration rather than
            treating each platform as a separate silo. We are comfortable working across business applications, data
            services, APIs, workflow automation and operational insight.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <p>
            Our experience includes Azure-backed systems, data migrations, reporting estates, Power Apps and model-driven
            applications, Power Automate workflows, Dataverse data models and integrations between portals,
            line-of-business systems and Microsoft cloud services.
          </p>
          <p>
            We also continue to support established technologies where they remain important to day-to-day operations,
            including SQL Server Reporting Services, Crystal Reports, Office automation and legacy Microsoft application
            estates.
          </p>
        </div>
      </div>
    </section>

    <section class="sector row" id="primary-skills">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2>Primary Skills</h2>
      </div>
      {primarySkills.map((skill) => (
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <article class="skill-card">
            <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
              {skill.icon === 'code' && (
                <>
                  <rect class="visual-panel" x="8" y="12" width="48" height="40" rx="5" />
                  <path class="visual-line" d="M24 25l-8 7 8 7M40 25l8 7-8 7M35 22l-6 20" />
                </>
              )}
              {skill.icon === 'database' && (
                <>
                  <ellipse class="visual-dark" cx="32" cy="15" rx="18" ry="7" />
                  <path class="visual-line" d="M14 15v28c0 4 8 7 18 7s18-3 18-7V15M14 29c0 4 8 7 18 7s18-3 18-7" />
                  <path class="visual-accent" d="M22 42h20v6H22z" />
                </>
              )}
              {skill.icon === 'power' && (
                <>
                  <rect class="visual-dark" x="10" y="10" width="20" height="20" rx="4" />
                  <rect class="visual-accent" x="34" y="10" width="20" height="20" rx="4" />
                  <rect class="visual-mid" x="10" y="34" width="20" height="20" rx="4" />
                  <path class="visual-line" d="M30 20h4M20 30v4M30 44h4M44 30v4" />
                </>
              )}
              {skill.icon === 'crm' && (
                <>
                  <circle class="visual-dark" cx="21" cy="22" r="9" />
                  <circle class="visual-accent" cx="43" cy="22" r="9" />
                  <path class="visual-line" d="M13 51c3-10 10-15 19-15s16 5 19 15M21 31h22" />
                </>
              )}
              {skill.icon === 'reporting' && (
                <>
                  <rect class="visual-panel" x="8" y="11" width="48" height="40" rx="5" />
                  <rect class="visual-dark" x="17" y="34" width="7" height="10" rx="1" />
                  <rect class="visual-accent" x="29" y="26" width="7" height="18" rx="1" />
                  <rect class="visual-mid" x="41" y="18" width="7" height="26" rx="1" />
                  <path class="visual-line" d="M15 48h36" />
                </>
              )}
              {skill.icon === 'api' && (
                <>
                  <rect class="visual-panel" x="8" y="13" width="18" height="18" rx="4" />
                  <rect class="visual-panel" x="38" y="13" width="18" height="18" rx="4" />
                  <rect class="visual-panel" x="23" y="37" width="18" height="18" rx="4" />
                  <path class="visual-line" d="M26 22h12M32 31v6M38 46H26" />
                  <circle class="visual-mid" cx="32" cy="22" r="4" />
                </>
              )}
            </svg>
            <h3>{skill.title}</h3>
            <p>{skill.text}</p>
          </article>
        </div>
      ))}
    </section>

    <section class="sector row" id="supporting-skills">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2>Supporting and Legacy Skills</h2>
        <p>
          We also support existing systems where older Microsoft or reporting technologies remain operationally
          important.
        </p>
        <ul class="skill-list">
          {supportingSkills.map((skill) => <li><span>{skill}</span></li>)}
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .experience-hero,
  .content-icon {
    display: block;
    height: auto;
  }

  .experience-hero {
    width: 100%;
  }

  .content-icon {
    height: 4rem;
    margin-bottom: 1rem;
    width: 4rem;
  }

  .skill-card {
    margin-bottom: 2rem;
  }

  .skill-list {
    columns: 2;
  }

  .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .visual-accent {
    fill: #8dd8f8;
  }

  .visual-mid {
    fill: #00baf2;
  }

  .visual-dark {
    fill: #0072bc;
  }

  @media (max-width: 991.98px) {
    section.maintained-experience-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-experience-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-experience-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .experience-hero {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-experience-splash .header-text {
      font-size: 1.6em;
    }

    .experience-hero {
      max-width: 13rem;
      width: 50%;
    }

    .skill-list {
      columns: 1;
    }
  }
</style>
