---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const sectors = [
  {
    icon: 'wealth',
    title: 'Wealth Management and Corporate Service Providers',
    text:
      'Experience across time recording, management information, Microsoft Dynamics CRM, intranet and extranet projects, data migration, integration work and customer or partner portals.'
  },
  {
    icon: 'public',
    title: 'Public Sector',
    text:
      'Delivery and consultancy work covering Microsoft Dynamics CRM, property management, grants and awards, data sharing, regulatory processes and operational systems.'
  },
  {
    icon: 'banking',
    title: 'Banking',
    text:
      'Support for CRM, reporting, data transformation, migration, Faster Payments, bank-grade payments, agency bank payment solutions, Confirmation of Payee (COP), returns processing, bulk statement generation, automated regulatory returns and general consultancy services.'
  },
  {
    icon: 'assurance',
    title: 'Life Assurance',
    text:
      'Experience supporting operational systems, reporting, data integration and consultancy requirements for life assurance environments.'
  },
  {
    icon: 'payroll',
    title: 'Outsourced Payroll Providers',
    text:
      'Systems covering workflow automation, timesheet and expense processing, P11D handling, onboarding, compliance and integration with Microsoft and accounting platforms.'
  },
  {
    icon: 'retail',
    title: 'Retail Solutions',
    text:
      'Retail and point-of-sale experience including reporting, stock control, address capture, barcoding, attendance systems and web store integration.'
  },
  {
    icon: 'utility',
    title: 'Utility Companies',
    text:
      'Operational software, stock and inventory management, and meter-reading related systems for utility environments.'
  },
  {
    icon: 'sport',
    title: 'Sporting Events',
    text:
      'Our team have built the web-based results and administration systems for every Island Games since 2004 and the Commonwealth Youth Games that took place in the Isle of Man in 2011.'
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/experience/past-experience/',
  areaServed: 'Isle of Man',
  description:
    'Antelle IT Ltd sector experience across Microsoft technology, bespoke software, reporting, integration and operational systems.'
};
---

<BaseLayout
  title="Sector Experience | Antelle IT Ltd"
  description="Sector experience from Antelle IT Ltd across Microsoft technology, bespoke software, reporting, integration and operational systems."
  pageClass="experience"
  canonicalUrl="https://www.antelle.com/experience/past-experience/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-experience-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Sector Experience</h1>
        <p class="header-text light">
          Practical delivery experience across regulated, operational and service-led organisations.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg
          class="img-splash img-fluid experience-hero"
          viewBox="0 0 420 260"
          role="img"
          aria-labelledby="sector-hero-title sector-hero-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="sector-hero-title">Sector experience map</title>
          <desc id="sector-hero-desc">Connected sectors represented as blue nodes around a delivery hub.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />
          <circle class="visual-dark" cx="210" cy="130" r="38" />
          <circle class="visual-mid" cx="98" cy="72" r="20" />
          <circle class="visual-accent" cx="320" cy="72" r="20" />
          <circle class="visual-mid" cx="96" cy="190" r="20" />
          <circle class="visual-accent" cx="320" cy="190" r="20" />
          <path class="visual-line" d="M118 72h62M238 130h62M118 190h62M238 130l66-48M238 130l66 50M180 130l-64-48M180 130l-66 50" />
          <path class="visual-tick" d="M193 130l14 14 29-38" />
        </svg>
      </div>
    </section>

    <section class="sector row" id="overview">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Overview</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <h3 class="header-2-text light">Experience built through practical delivery.</h3>
          <p>
            Antelle has worked across a range of sectors where software, data, integration and long-term support matter
            to day-to-day operations.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <p>
            This page is now maintained in Astro and ready for further editing. The content below keeps the existing
            sector structure while making the claims easier to review and update.
          </p>
          <p>
            <span class="owner-note">FACT CHECK REQUIRED: confirm sector wording and any public client/project references before go-live.</span>
          </p>
        </div>
      </div>
    </section>

    <section class="sector-grid row" id="sectors">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2>Experience Areas</h2>
      </div>
      {sectors.map((item) => (
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <article class="experience-card">
            <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
              {item.icon === 'wealth' && (
                <>
                  <rect class="visual-dark" x="12" y="34" width="8" height="18" rx="1" />
                  <rect class="visual-accent" x="28" y="24" width="8" height="28" rx="1" />
                  <rect class="visual-mid" x="44" y="14" width="8" height="38" rx="1" />
                  <path class="visual-line" d="M12 54h42" />
                </>
              )}
              {item.icon === 'public' && (
                <>
                  <path class="visual-dark" d="M32 9l23 12H9L32 9Z" />
                  <path class="visual-line" d="M15 25v24M27 25v24M39 25v24M51 25v24M11 53h42" />
                </>
              )}
              {item.icon === 'banking' && (
                <>
                  <rect class="visual-panel" x="8" y="13" width="48" height="38" rx="5" />
                  <rect class="visual-dark" x="15" y="21" width="18" height="7" rx="2" />
                  <rect class="visual-accent" x="37" y="21" width="10" height="7" rx="2" />
                  <path class="visual-line" d="M16 39h27M35 33l8 6-8 6M48 32H21M29 26l-8 6 8 6" />
                </>
              )}
              {item.icon === 'assurance' && (
                <>
                  <path class="visual-dark" d="M32 8l21 9v13c0 14-8 24-21 28C19 54 11 44 11 30V17l21-9Z" />
                  <path class="visual-tick" d="M22 32l7 7 15-18" />
                </>
              )}
              {item.icon === 'payroll' && (
                <>
                  <rect class="visual-panel" x="10" y="14" width="44" height="36" rx="4" />
                  <path class="visual-line" d="M18 27h20M18 38h28" />
                  <circle class="visual-mid" cx="47" cy="19" r="8" />
                  <path class="visual-tick" d="M43 19l3 3 7-9" />
                </>
              )}
              {item.icon === 'retail' && (
                <>
                  <path class="visual-line" d="M13 17h6l5 25h23l5-16H24" />
                  <circle class="visual-dark" cx="27" cy="51" r="5" />
                  <circle class="visual-mid" cx="45" cy="51" r="5" />
                  <rect class="visual-accent" x="28" y="14" width="21" height="9" rx="2" />
                </>
              )}
              {item.icon === 'utility' && (
                <>
                  <path class="visual-line" d="M32 8v16M20 30l12-6 12 6M20 30l-7 24M44 30l7 24M20 30h24M16 42h32M13 54h38" />
                  <circle class="visual-mid" cx="32" cy="24" r="6" />
                </>
              )}
              {item.icon === 'sport' && (
                <>
                  <path class="visual-dark" d="M20 8h12l-5 19H15L20 8Z" />
                  <path class="visual-mid" d="M32 8h12l5 19H37L32 8Z" />
                  <circle class="visual-panel" cx="32" cy="39" r="15" />
                  <path class="visual-line" d="M32 31l3 6 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1 3-6Z" />
                </>
              )}
            </svg>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .experience-hero,
  .content-icon {
    display: block;
    height: auto;
  }

  .experience-hero {
    width: 100%;
  }

  .content-icon {
    height: 4rem;
    margin-bottom: 1rem;
    width: 4rem;
  }

  .experience-card {
    margin-bottom: 2rem;
  }

  .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .visual-accent {
    fill: #8dd8f8;
  }

  .visual-mid {
    fill: #00baf2;
  }

  .visual-dark {
    fill: #0072bc;
  }

  .owner-note {
    background: #fff59d;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (max-width: 991.98px) {
    section.maintained-experience-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-experience-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-experience-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .experience-hero {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-experience-splash .header-text {
      font-size: 1.6em;
    }

    .experience-hero {
      max-width: 13rem;
      width: 50%;
    }
  }
</style>
