---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectorIcon from '../../../components/SectorIcon.astro';
import { sectors } from '../../../content/sectors';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/experience/past-experience/',
  areaServed: 'Isle of Man',
  description:
    'Antelle IT Ltd sector experience across Microsoft technology, bespoke software, reporting, integration and operational systems.'
};
---

<BaseLayout
  title="Sector Experience | Antelle IT Ltd"
  description="Sector experience from Antelle IT Ltd across Microsoft technology, bespoke software, reporting, integration and operational systems."
  pageClass="experience"
  canonicalUrl="https://www.antelle.com/experience/past-experience/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-experience-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Sector Experience</h1>
        <p class="header-text light">
          Practical delivery experience across regulated, operational and service-led organisations.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg
          class="img-splash img-fluid experience-hero"
          viewBox="0 0 420 260"
          role="img"
          aria-labelledby="sector-hero-title sector-hero-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="sector-hero-title">Sector delivery experience</title>
          <desc id="sector-hero-desc">Regulated-sector project cards connected to a central Microsoft data and workflow platform.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />

          <rect class="visual-soft" x="152" y="76" width="116" height="108" rx="8" />
          <rect class="visual-dark" x="174" y="98" width="72" height="48" rx="5" />
          <path class="visual-tick" d="M192 121l13 13 27-34" />
          <path class="visual-line thin" d="M178 160h64M190 172h40" />

          <rect class="visual-card" x="48" y="44" width="92" height="58" rx="6" />
          <path class="visual-line thin" d="M66 66h38M66 80h55" />
          <path class="visual-accent-shape" d="M114 54h14v38h-14z" />
          <path class="visual-line connector" d="M140 74h34" />

          <rect class="visual-card" x="280" y="44" width="92" height="58" rx="6" />
          <path class="visual-dark-shape" d="M326 54l32 16-32 16-32-16 32-16Z" />
          <path class="visual-line thin white-line" d="M312 70h28" />
          <path class="visual-line connector" d="M246 74h34" />

          <rect class="visual-card" x="48" y="158" width="92" height="58" rx="6" />
          <path class="visual-line thin" d="M66 176h20M66 190h54" />
          <path class="visual-mid-shape" d="M98 174h18v18H98z" />
          <path class="visual-line connector" d="M140 188h34" />

          <rect class="visual-card" x="280" y="158" width="92" height="58" rx="6" />
          <path class="visual-line thin" d="M300 176h30M300 190h50" />
          <path class="visual-line arrow" d="M334 136v26M324 154l10 10 10-10" />
          <path class="visual-line connector" d="M246 188h34" />

          <path class="visual-line arc" d="M210 76c0-24 18-42 44-42M210 184c0 24-18 42-44 42" />
          <circle class="visual-mid" cx="254" cy="34" r="7" />
          <circle class="visual-accent" cx="166" cy="226" r="7" />
        </svg>
      </div>
    </section>

    <section class="sector row" id="overview">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Overview</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <h3 class="header-2-text light">Experience built through practical delivery.</h3>
          <p>
            Antelle has worked across a range of sectors where software, data, integration and long-term support matter
            to day-to-day operations.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <p>
            Much of our work sits behind the scenes: back-office systems, integrations, reporting, workflow automation
            and long-term platform support. Those systems are often business-critical, so our focus is on practical
            delivery, clear ownership and maintainable technology.
          </p>
        </div>
      </div>
    </section>

    <section class="sector-grid row" id="sectors">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2>Experience Areas</h2>
      </div>
      {sectors.map((item) => (
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <article class="experience-card">
            <SectorIcon icon={item.icon} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        </div>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .experience-hero,
  .content-icon {
    display: block;
    height: auto;
  }

  .experience-hero {
    width: 100%;
  }

  .content-icon {
    height: 4rem;
    margin-bottom: 1rem;
    width: 4rem;
  }

  .experience-card {
    margin-bottom: 2rem;
  }

  .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .visual-card {
    fill: #ffffff;
    stroke: rgba(0, 114, 188, 0.28);
    stroke-width: 2;
  }

  .visual-soft {
    fill: rgba(141, 216, 248, 0.24);
    stroke: #00baf2;
    stroke-width: 2;
  }

  .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .visual-line.thin {
    stroke-width: 3;
  }

  .visual-line.connector {
    stroke: rgba(0, 114, 188, 0.4);
    stroke-width: 4;
  }

  .visual-line.arc {
    stroke: rgba(0, 114, 188, 0.35);
    stroke-dasharray: 6 8;
    stroke-width: 3;
  }

  .visual-line.arrow {
    stroke: #00baf2;
    stroke-width: 4;
  }

  .white-line {
    stroke: #ffffff;
  }

  .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .visual-accent {
    fill: #8dd8f8;
  }

  .visual-accent-shape {
    fill: #8dd8f8;
  }

  .visual-mid {
    fill: #00baf2;
  }

  .visual-mid-shape {
    fill: #00baf2;
  }

  .visual-dark {
    fill: #0072bc;
  }

  .visual-dark-shape {
    fill: #0072bc;
  }

  .owner-note {
    background: #fff59d;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (max-width: 991.98px) {
    section.maintained-experience-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-experience-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-experience-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .experience-hero {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-experience-splash .header-text {
      font-size: 1.6em;
    }

    .experience-hero {
      max-width: 13rem;
      width: 50%;
    }
  }
</style>
