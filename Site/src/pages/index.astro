---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConversationCta from '../components/ConversationCta.astro';
import SectorIcon from '../components/SectorIcon.astro';
import { sectors } from '../content/sectors';
import { services as siteServices } from '../content/services';

const asset = (path: string) => `/assets/${path}`;

const homeServiceOrder = [
  'Power Platform',
  'Low-Code Governance',
  'Microsoft Dynamics CRM',
  'Software Development',
  'Web Development',
  'Business Intelligence',
  'Consultancy'
];

const homeServiceText: Record<string, string> = {
  'Microsoft Dynamics CRM':
    'Design, delivery and long-term support for Dynamics 365 and Dataverse solutions across regulated, operational and service-led organisations.',
  'Power Platform':
    'Practical Power Apps, Power Automate, Dataverse and Power BI solutions, built with the governance and support needed for long-term use.',
  'Low-Code Governance':
    'We help organisations review, stabilise and strengthen Power Platform, Dataverse and Dynamics solutions that now need better governance, security, integration, reporting or support.',
  'Web Development':
    'Modern web applications, portals and APIs using Microsoft cloud services, with a focus on secure integration, maintainability and practical delivery.',
  'Software Development':
    'Bespoke software for business-critical processes, from cloud-hosted applications and integrations to supported legacy system modernisation.',
  'Business Intelligence':
    'Azure SQL, Power BI and Microsoft data platform reporting that helps teams work from reliable, governed operational data.',
  Consultancy:
    'Clear advice on Microsoft technology, cloud migration, integration, requirements and delivery planning for organisations making system change.'
};

const services = homeServiceOrder.map((title) => {
  const service = siteServices.find((item) => item.title === title);

  if (!service) {
    throw new Error(`Missing homepage service: ${title}`);
  }

  return {
    ...service,
    alt: `${service.title} Image`,
    columnClass:
      title === 'Power Platform' || title === 'Low-Code Governance' || title === 'Microsoft Dynamics CRM'
        ? 'col-12 col-sm-12 col-md-6 col-lg-4'
        : 'col-12 col-sm-12 col-md-6 col-lg-6',
    cardClass: title === 'Software Development' || title === 'Web Development' ? 'service service-card-light' : 'service',
    text: homeServiceText[service.title] ?? service.summary
  };
});

const problemCards = [
  {
    title: 'Your CRM or Dataverse estate is becoming harder to change',
    href: '/services/microsoft-dynamics-crm/',
    text: 'We help review, modernise, migrate and support Microsoft CRM, Dynamics 365 and Dataverse systems where data, process, reporting and integration need to keep working reliably.'
  },
  {
    title: 'A low-code solution has become business-critical',
    href: '/services/low-code-business-critical/',
    text: 'We help strengthen Power Platform and Dataverse solutions that now need clearer ownership, safer deployment, stronger security, reliable reporting or deeper technical support.'
  },
  {
    title: 'Reporting is difficult to trust',
    href: '/services/business-intelligence/',
    text: 'We help organisations build reporting foundations around reliable data sources, Azure SQL, Dataverse and Power BI so teams can work from numbers they understand.'
  },
  {
    title: 'A legacy or bespoke system still matters',
    href: '/services/software-development/',
    text: 'We support, stabilise and modernise older Microsoft-based systems where replacement needs care and the business still depends on the current process.'
  },
  {
    title: 'Systems need to talk to each other properly',
    href: '/services/software-development/',
    text: 'We design and support practical integrations between CRM, Dataverse, Microsoft 365, Azure services, databases, portals and line-of-business systems.'
  },
  {
    title: 'You need senior technical input before committing',
    href: '/services/consultancy/',
    text: 'We provide practical review and consultancy where an organisation needs clear options, realistic risks and experienced judgement before starting or rescuing a project.'
  }
];

const customers = [
  ['images/clients/client-logo-ardan.png', 'Ardan International'],
  ['images/clients/client-logo-ifgl.png', 'IFGL'],
  ['images/clients/client-iomgovernment.jpg', 'Isle of Man Government'],
  ['images/clients/client-logo-fsa.png', 'Isle of Man Financial Services Authority'],
  ['images/clients/client-logo-boalandco.png', 'Boal and Co'],
  ['images/clients/client-logo-gsc.png', 'Gambling Supervision Commission'],
  ['images/clients/client-conister.png', 'Conister Bank'],
  ['images/clients/client-manxutilities.jpg', 'Manx Utilities'],
  ['images/clients/client-maitland.jpg', 'Maitland'],
  ['images/clients/client-stateguernsey.jpg', 'States of Guernsey'],
  ['images/clients/client-digimap.jpg', 'Digimap'],
  ['images/clients/client-dohle.jpg', 'Dohle Corporate Trust Services'],
  ['images/clients/client-cig.jpg', 'Capital International'],
  ['images/clients/client-pdms.jpg', 'PDMS']
];
---

<BaseLayout
  title="Home | Antelle IT Ltd"
  description="Antelle helps Isle of Man and UK organisations design, modernise and support business-critical Microsoft systems across Dynamics 365, Dataverse, Power Platform, Azure SQL, Power BI and bespoke .NET development."
  pageClass="homepage"
>
  <div class="container">
    <section class="splash row">
      <div class="col-11 col-sm-10 col-md-8 col-lg-6 col-xl-6">
        <h1 class="light">Innovative solutions for business problems.</h1>
        <p>
          We provide quality software solutions to business problems, delivered with the excellent on-going support that
          our customers expect. We focus almost exclusively on a Microsoft technology stack.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <img class="img-splash img-fluid" src={asset('images/heroes/splash-landing.svg')} alt="Splash graphic" />
      </div>
    </section>

    <section class="services">
      <div class="row">
        {
          services.map((service) => (
            <div class={service.columnClass}>
              <a href={service.href} class={service.cardClass}>
                <span class="icon">
                  <img class="img-fluid" src={asset(service.icon)} alt={service.alt} />
                </span>
                <h4>
                  {service.title}
                  <svg class="icon-arrow" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                    <g class="nc-icon-wrapper">
                      <path d="M8.59 16.34l4.58-4.59-4.58-4.59L10 5.75l6 6-6 6z" />
                    </g>
                  </svg>
                </h4>
                <span class="caption-text">{service.text}</span>
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section class="when-to-speak row">
      <div class="col-12">
        <h2>When to speak to Antelle</h2>
        <p class="header-2-text light">
          Organisations do not usually need help because they want more technology. They need help because an important
          system is becoming harder to support, change, integrate or trust.
        </p>
        <p>
          Antelle is a good fit where Microsoft-based systems, data and processes have become business-critical and need
          practical engineering discipline around them.
        </p>
      </div>
      {
        problemCards.map((card) => (
          <div class="col-12 col-sm-12 col-md-6 col-lg-4">
            <a class="problem-card" href={card.href}>
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </a>
          </div>
        ))
      }
    </section>

    <ConversationCta
      title="Have a system that is becoming difficult to support, report from or change?"
      buttonText="Contact Antelle"
    >
      <p>
        Send us a short outline of the system, what it does, and what is starting to feel risky or difficult.
      </p>
      <p>We will tell you whether it sounds like something we can sensibly help with.</p>
    </ConversationCta>

    <section class="experience row">
      <div class="col-8 col-sm-6 col-md-4 col-lg-4 col-xl-4">
        <div class="img-wrapper">
          <img class="img-fluid img-fluid" src={asset('images/heroes/splash-experience-sector.png')} alt="Past Experience" />
        </div>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-8 col-xl-8">
        <div class="experience-content">
          <h2>Sector Experience</h2>
          <p class="header-text light">
            Our experienced team have delivered successful projects and provided consultancy across a broad range of
            sectors in both the public and private sectors.
          </p>
          <ul class="experience-list">
            {
              sectors.map((sector) => (
                <li>
                  <SectorIcon icon={sector.icon} className="homepage-sector-icon" />
                  <span>{sector.title}</span>
                </li>
              ))
            }
            <li>
              <a href="/experience/past-experience/" class="cta">Learn More</a>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section class="coreskills row">
      <div class="col-8 col-sm-6 col-md-3 col-lg-3 col-xl-2">
        <div class="image-wrapper">
          <img class="img-fluid" src={asset('images/heroes/splash-experience-coreskills.png')} alt="Core Skills" />
        </div>
      </div>
      <div class="col-12 col-sm-12 col-md-9 col-lg-9 col-xl-10">
        <h2>Core Skills</h2>
        <p class="header-text light">
          Practical Microsoft technology skills for systems that need to be secure, maintainable and useful over the
          long term.
        </p>
      </div>
      <div class="blurb col-12 col-sm-12 col-md-6 col-lg-5 col-xl-5">
        <p><span class="header-text light">Our strength is applying the right Microsoft tools to real operational problems.</span></p>
        <p>
          We work across business applications, data, integration and bespoke development, with particular experience in
          Dynamics 365, Dataverse, Power Platform, Azure SQL and .NET-based systems.
        </p>
        <p>
          The focus is always on fit: choosing technology that supports the process, can be governed properly and can be
          supported with confidence once it is in day-to-day use.
        </p>
      </div>
      <div class="tools col-12 col-sm-12 col-md-6 col-lg-7 col-xl-7">
        <h4>Core Technology Areas</h4>
        <ul>
          <li><span>Dynamics 365, Dataverse and model-driven business applications</span></li>
          <li><span>Power Platform, Power Automate, Power BI and governed low-code delivery</span></li>
          <li><span>Azure SQL, SQL Server, reporting, data migration and operational data platforms</span></li>
          <li><span>.NET, C#, APIs, web applications and integration services</span></li>
          <li><span>Legacy system support, modernisation and practical cloud migration</span></li>
        </ul>
        <a href="/experience/core-skills/" class="cta">View Core Skills</a>
      </div>
    </section>

    <section class="customers row">
      <div class="col-12">
        <p class="header-text light">We're trusted by international and local customers:</p>
      </div>
      {
        customers.map(([src, alt]) => (
          <div class="customer">
            <img src={asset(src)} alt={alt} />
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style is:global>
  .homepage main.content section.services .service.service-card-light {
    background-color: #ffffff;
  }

  .homepage main.content section.services .service.service-card-light h4 {
    color: #0072bc;
  }

  .homepage main.content section.services .service.service-card-light h4 .icon-arrow path {
    fill: #0072bc;
  }

  .homepage main.content section.services .service.service-card-light span {
    color: #343f4b;
  }

  .homepage main.content section.services .service.service-card-light:hover,
  .homepage main.content section.services .service.service-card-light:focus {
    background-color: #f2f2f2;
    transition: background-color 0.33s linear;
  }

  .homepage main.content section.services .service.service-card-light:active {
    background-color: #e6e6e6;
    transition: background-color 0.15s linear;
  }

  .homepage main.content section.when-to-speak {
    padding-top: 4rem;
  }

  .homepage main.content section.when-to-speak h2 {
    color: #0072bc;
    font-size: 0.9em;
    text-transform: uppercase;
  }

  .homepage main.content section.when-to-speak > div:first-child {
    margin-bottom: 1.5rem;
  }

  .homepage main.content section.when-to-speak .header-2-text {
    max-width: 55rem;
  }

  .homepage main.content section.when-to-speak .problem-card {
    background-color: rgba(0, 186, 242, 0.1);
    border-left: 4px solid #00baf2;
    box-shadow: 0 8px 16px 0 rgba(52, 64, 75, 0.16);
    color: #343f4b;
    display: block;
    height: 100%;
    padding: 2rem;
    transition: background-color 0.25s linear, color 0.25s linear;
  }

  .homepage main.content section.when-to-speak .problem-card:hover,
  .homepage main.content section.when-to-speak .problem-card:focus {
    background-color: rgba(0, 186, 242, 0.16);
    color: #0072bc;
    text-decoration: none;
  }

  .homepage main.content section.when-to-speak .problem-card h3 {
    color: #0072bc;
    font-size: 1.25em;
  }

  .homepage main.content section.when-to-speak .problem-card p {
    font-family: 'AntelleSans-Regular', arial, sans-serif;
    margin-bottom: 0;
  }

  .homepage main.content section.when-to-speak > div {
    margin-bottom: 1.5rem;
  }

  .homepage main.content section.experience .homepage-sector-icon {
    display: inline-block;
    flex: 0 0 auto;
    height: 24px !important;
    margin-right: 0.75rem;
    max-height: 24px !important;
    max-width: 24px !important;
    min-width: 24px;
    vertical-align: middle;
    width: 24px !important;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-accent {
    fill: #8dd8f8;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-mid {
    fill: #00baf2;
  }

  .homepage main.content section.experience .homepage-sector-icon .visual-dark {
    fill: #0072bc;
  }
</style>
