---
import BaseLayout from '../../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Privacy Policy',
  url: 'https://www.antelle.com/privacy-policy/',
  description:
    'Privacy policy for Antelle IT Ltd, explaining how personal data is collected, used, retained and protected.'
};
---

<BaseLayout
  title="Privacy Policy | Antelle IT Ltd"
  description="Privacy policy for Antelle IT Ltd, explaining how personal data is collected, used, retained and protected under Isle of Man data protection legislation."
  pageClass="about privacy-policy"
  canonicalUrl="https://www.antelle.com/privacy-policy/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-privacy-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Privacy Policy</h1>
        <p class="header-text light">
          Antelle IT Ltd respects your privacy and handles personal data in line with Isle of Man data protection
          legislation.
        </p>
        <p>
          Our quality and information security systems are aligned to ISO 27001 principles, including controlled access,
          secure handling of information and continual improvement.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <img class="img-splash img-fluid privacy-hero" src="/assets/images/heroes/aboutus-whoweare.png" alt="Privacy Policy" />
      </div>
    </section>

    <section class="sector row privacy-intro" id="summary">
      <div class="col-12">
        <h2>Summary</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          This notice explains how Antelle IT Ltd collects and uses personal data through this website, by email, through
          enquiry forms, during support or consultancy discussions, and where individuals send us information such as a
          CV.
        </p>
        <p>
          We only collect personal data where we need it for a clear purpose. We use it to respond to enquiries, provide
          services, manage support and contractual relationships, keep appropriate business records and protect the
          security of our systems.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          This notice was last updated on 6 May 2026. It is intended to reflect the Data Protection Act 2018, the Data
          Protection (Application of GDPR) Order 2018, the Applied GDPR and related Isle of Man data protection
          legislation.
        </p>
      </div>
    </section>

    <section class="sector row" id="controller">
      <div class="col-12">
        <h2>Who Is Responsible For Your Data</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          Antelle IT Ltd is the controller for personal data collected through this website and through direct enquiries
          made to us.
        </p>
        <p>
          Antelle IT Ltd<br />
          Unit 17b, Carrs Lane<br />
          Tromode Estate<br />
          Douglas<br />
          Isle of Man<br />
          IM4 4RG
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          For privacy enquiries, data subject requests or questions about this notice, please contact:
        </p>
        <p>
          Email: <a href="mailto:hello@antelle.com">hello@antelle.com</a><br />
          Phone: +44 (0)1624 660613
        </p>
      </div>
    </section>

    <section class="sector row" id="information-collected">
      <div class="col-12">
        <h2>Information We Collect And Why</h2>
      </div>
      <div class="col-12">
        <div class="privacy-card-grid">
          <article class="privacy-card">
            <h3>Website or Email Enquiries</h3>
            <p>
              We collect the contact details and message information you provide, such as your name, organisation, email
              address and phone number.
            </p>
            <p>
              We use this information to respond to your enquiry, discuss possible services and decide whether we can
              help.
            </p>
            <p><strong>Lawful basis:</strong> legitimate interests and, where relevant, steps prior to entering a contract.</p>
          </article>
          <article class="privacy-card">
            <h3>Client, Supplier and Support Relationships</h3>
            <p>
              We may hold business contact details, correspondence, support records, service details and account
              information.
            </p>
            <p>
              We use this information to deliver services, provide support, manage accounts, keep business records and
              maintain the systems we are responsible for.
            </p>
            <p><strong>Lawful basis:</strong> contract, legitimate interests and legal obligations.</p>
          </article>
          <article class="privacy-card">
            <h3>Recruitment and CV Enquiries</h3>
            <p>
              If you send us a CV or speculative enquiry, we may hold your contact details, CV, work history and any
              other information you choose to provide.
            </p>
            <p>
              We use this information to respond to you and consider whether a suitable role may arise.
            </p>
            <p><strong>Lawful basis:</strong> consent, legitimate interests and steps prior to entering a contract.</p>
          </article>
          <article class="privacy-card">
            <h3>Website Operation and Security</h3>
            <p>
              Web servers and security tools may record technical information such as IP address, browser details,
              request logs, dates, times and error diagnostics.
            </p>
            <p>
              We use this information to operate, secure, troubleshoot and improve the website.
            </p>
            <p><strong>Lawful basis:</strong> legitimate interests in maintaining secure and reliable systems.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="sector row" id="special-category-data">
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <h2>Special Category Data</h2>
        <p>
          Please do not send us special category personal data through the website unless it is necessary for the matter
          you are asking us to consider. Special category data includes information about health, racial or ethnic
          origin, political opinions, religious beliefs, trade union membership, genetic data, biometric data used for
          identification, sex life or sexual orientation.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <h2>Information From Third Parties</h2>
        <p>
          In most cases we receive personal data directly from you or from the organisation you represent. Where we
          receive information from another source, we will only use it where we have a lawful reason and where it is
          relevant to the service, enquiry or support matter being handled.
        </p>
      </div>
    </section>

    <section class="sector row" id="sharing">
      <div class="col-12">
        <h2>Who We Share Information With</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          We do not sell personal data. We may share personal data with trusted service providers who help us operate
          our business, such as hosting providers, Microsoft cloud services, email providers, professional advisers,
          accountants, insurers and support suppliers.
        </p>
        <p>
          We may also disclose information where required by law, where needed to establish or defend legal rights, or
          where necessary to protect the security of our systems or the systems we support.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          Where a supplier processes personal data for us, we expect appropriate confidentiality, security and data
          protection controls to be in place.
        </p>
        <p>
          If personal data is transferred outside the Isle of Man, the UK or the EEA, we will use appropriate safeguards
          where required by applicable data protection law.
        </p>
      </div>
    </section>

    <section class="sector row" id="retention">
      <div class="col-12">
        <h2>How Long We Keep Information</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          We keep personal data only for as long as it is needed for the purpose it was collected, including any legal,
          accounting, contractual or support obligations.
        </p>
        <ul>
          <li><span>General enquiries are normally kept for up to 24 months unless they become part of an ongoing client or supplier relationship.</span></li>
          <li><span>Client, supplier and contract records are normally kept for the duration of the relationship and then for up to 6 years.</span></li>
          <li><span>Support records are kept for as long as needed to provide support, maintain audit history and manage contractual obligations.</span></li>
        </ul>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <ul>
          <li><span>CVs and speculative recruitment enquiries are normally kept for up to 12 months, unless you ask us to delete them sooner or agree a longer period.</span></li>
          <li><span>Website security and server logs are normally kept for up to 12 months unless they are needed for security, investigation or legal purposes.</span></li>
          <li><span>Where data is no longer required, we will delete it or anonymise it where practical.</span></li>
        </ul>
      </div>
    </section>

    <section class="sector row" id="cookies-and-logs">
      <div class="col-12">
        <h2>Cookies, Analytics And Log Files</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          The maintained static version of this website does not currently use Google Analytics or marketing cookies.
          If analytics, marketing tracking or a cookie consent tool is introduced, this notice will need to be updated
          to explain what is used and what choices visitors have.
        </p>
        <p>
          The website may use essential technical assets and scripts that are needed to display and navigate the site.
          Our stylesheet also references a font licensing service, which may receive standard technical request
          information when fonts are loaded.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          Web servers normally create log files containing technical information such as IP address, browser type,
          requested page, date and time of access and error information. We use this information to operate, secure and
          troubleshoot the website.
        </p>
        <p>
          You can control or block cookies through your browser settings. Some site functions may not work correctly if
          essential cookies or scripts are blocked.
        </p>
      </div>
    </section>

    <section class="sector row" id="rights">
      <div class="col-12">
        <h2>Your Rights</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          Subject to the conditions and exemptions in Isle of Man data protection law, you may have the right to:
        </p>
        <ul>
          <li><span>be informed about how your personal data is used;</span></li>
          <li><span>access the personal data we hold about you;</span></li>
          <li><span>ask us to correct inaccurate or incomplete data;</span></li>
          <li><span>ask us to erase personal data in certain circumstances;</span></li>
          <li><span>ask us to restrict processing in certain circumstances;</span></li>
        </ul>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <ul>
          <li><span>object to processing in certain circumstances;</span></li>
          <li><span>receive certain data in a portable format;</span></li>
          <li><span>withdraw consent where we rely on consent, without affecting earlier lawful processing;</span></li>
          <li><span>complain to the Isle of Man Information Commissioner.</span></li>
        </ul>
        <p>
          To exercise a right, please contact us using the details in this notice. We may need to confirm your identity
          before responding.
        </p>
      </div>
    </section>

    <section class="sector row" id="security">
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <h2>How We Protect Information</h2>
        <p>
          We use technical and organisational measures to protect personal data, including access controls, secure
          systems, managed backups, supplier controls and internal quality processes. Our approach is aligned to ISO
          27001 principles, although this notice should not be read as a claim of current ISO 27001 certification.
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <h2>Other Websites</h2>
        <p>
          This website may link to other websites. We are not responsible for the privacy practices or content of those
          websites. You should read the privacy notice on any third-party website you visit.
        </p>
      </div>
    </section>

    <section class="sector row" id="complaints">
      <div class="col-12">
        <h2>Questions Or Complaints</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          If you have a question or complaint about how we handle personal data, please contact us first so we can try
          to resolve it.
        </p>
        <p>
          Email: <a href="mailto:hello@antelle.com">hello@antelle.com</a><br />
          Phone: +44 (0)1624 660613
        </p>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <p>
          You also have the right to ask the Isle of Man Information Commissioner to assess whether your personal data
          has been handled in accordance with Isle of Man data protection legislation.
        </p>
        <p>
          Isle of Man Information Commissioner<br />
          P.O. Box 69, Douglas, Isle of Man, IM99 1EQ<br />
          Phone: +44 1624 693260<br />
          Email: <a href="mailto:ask@inforights.im">ask@inforights.im</a><br />
          Website: <a href="https://www.inforights.im/">www.inforights.im</a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .privacy-policy .privacy-hero {
    width: 360px;
  }

  .privacy-policy .sector {
    padding-top: 5rem;
  }

  .privacy-policy .privacy-card-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .privacy-policy .privacy-card {
    background: linear-gradient(to bottom, rgba(0, 186, 242, 0.16) 0%, rgba(141, 216, 248, 0.12) 100%);
    height: 100%;
    padding: 2rem;
  }

  .privacy-policy .privacy-card h3 {
    color: #0072bc;
  }

  .privacy-policy .privacy-card p:last-child {
    margin-bottom: 0;
  }

  .privacy-policy .privacy-card strong {
    font-family: 'UniversNextPro-Bold', arial, sans-serif;
  }

  .privacy-policy .owner-note {
    background: #fff59d;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  @media (max-width: 991.98px) {
    .privacy-policy .privacy-card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
