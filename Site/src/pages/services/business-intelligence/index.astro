---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OtherServices from '../../../components/OtherServices.astro';
import ExploreProjectsCta from '../../../components/ExploreProjectsCta.astro';
import ConversationCta from '../../../components/ConversationCta.astro';

const asset = (path: string) => `/assets/${path}`;

const featuredCapabilities = [
  {
    title: 'Azure SQL',
    icon: 'images/icons/bi/icon-database.png',
    text: 'Design, migration and optimisation of SQL-backed data platforms using Microsoft Azure SQL services where they are the right fit for the workload, governance model and budget.',
    points: ['Data modelling and schema design', 'Performance tuning and query review', 'Secure reporting data sources']
  },
  {
    title: 'Power BI',
    icon: 'images/icons/bi/icon-chart.png',
    text: 'Clear, maintainable Power BI reporting that helps teams see operational trends, measure performance and make informed decisions from trusted data.',
    points: ['Dashboards and management reporting', 'Data model design', 'Practical report governance']
  }
];

const supportingCapabilities = [
  {
    title: 'SQL Server and SSRS',
    icon: 'bar-chart',
    text: 'Support for established SQL Server and SQL Server Reporting Services estates, including report maintenance, tuning and migration planning.'
  },
  {
    title: 'Data Integration',
    icon: 'integration',
    text: 'Connecting data from line-of-business systems so reporting is based on consistent, understood sources rather than manual spreadsheet handling.'
  },
  {
    title: 'Crystal Reports',
    icon: 'report-laptop',
    text: 'Ongoing support for legacy Crystal Reports where existing systems still rely on them, with a practical path towards newer reporting options when appropriate.'
  }
];

const typicalEngagements = [
  'Azure SQL migration and optimisation',
  'Power BI report rebuilds and dashboard design',
  'Reporting data model review',
  'Dataverse reporting support',
  'Operational data integration',
  'Report governance and handover planning',
  'Performance tuning for reporting workloads'
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/services/business-intelligence/',
  areaServed: 'Isle of Man',
  serviceType: ['Azure SQL consultancy', 'Power BI reporting', 'Dataverse reporting', 'Business intelligence consultancy'],
  description:
    'Business intelligence consultancy for Azure SQL, Power BI reporting and Microsoft data platform delivery.'
};
---

<BaseLayout
  title="Business Intelligence | Antelle IT Ltd"
  description="Azure SQL and Power BI reporting consultancy from Antelle IT Ltd, helping Isle of Man organisations build reliable Microsoft data platform reporting."
  pageClass="services"
  canonicalUrl="https://www.antelle.com/services/business-intelligence/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-service-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Business Intelligence</h1>
        <p class="header-text light">
          Turn operational data into reliable reporting with Azure SQL, Power BI and the wider Microsoft data platform.
        </p>
        <a href="/contact/" class="cta cta-large">Discuss a BI Requirement</a>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg
          class="img-splash img-fluid bi-hero-visual"
          viewBox="0 0 420 260"
          role="img"
          aria-labelledby="bi-hero-visual-title bi-hero-visual-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="bi-hero-visual-title">Power BI reporting dashboard</title>
          <desc id="bi-hero-visual-desc">A reporting dashboard with charts, KPIs and governed data.</desc>
          <rect class="bi-visual-panel" x="10" y="10" width="400" height="240" rx="8" />
          <g transform="translate(-12 -8) scale(1.16)">
            <rect class="bi-visual-dark" x="66" y="64" width="86" height="28" rx="3" />
            <rect class="bi-visual-accent" x="168" y="64" width="86" height="28" rx="3" />
            <rect class="bi-visual-mid" x="270" y="64" width="84" height="28" rx="3" />
            <path class="bi-visual-line" d="M72 174c30-44 63-17 91-47s63-16 96 12 56-7 82-39" />
            <circle class="bi-visual-accent" cx="286" cy="156" r="38" />
            <path class="bi-visual-dark" d="M286 118a38 38 0 0 1 33 57l-33-19Z" />
            <path class="bi-visual-mid" d="M286 118v38l-33 19a38 38 0 0 1 33-57Z" />
            <rect class="bi-visual-mid" x="72" y="139" width="18" height="52" rx="2" />
            <rect class="bi-visual-accent" x="101" y="122" width="18" height="69" rx="2" />
            <rect class="bi-visual-dark" x="130" y="104" width="18" height="87" rx="2" />
          </g>
        </svg>
      </div>
    </section>

    <section class="sector row" id="overview">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Overview</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <h3 class="header-2-text light">Good reporting starts with dependable data.</h3>
          <p>
            Many organisations have the data they need, but it is spread across operational systems, spreadsheets and
            legacy reports. We help bring that information together in a way that is secure, understandable and useful.
          </p>
          <p>
            Our current focus is Microsoft Azure SQL for dependable data foundations and Power BI for practical,
            decision-ready reporting, including reporting over Dataverse where it forms part of the operational estate.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <p>
            We can help with reporting data models, SQL performance, dashboard design, report governance and the
            transition from older reporting tools to modern Microsoft platform services.
          </p>
          <p>
            Existing skills such as SQL Server Reporting Services, Crystal Reports, data warehousing and data
            transformation remain available where they are part of a client's current estate.
          </p>
        </div>
      </div>
    </section>

    <section class="solutions bi-primary row">
      <div class="col-12">
        <h2>Azure SQL and Power BI Delivery</h2>
      </div>
      {
        featuredCapabilities.map((capability) => (
          <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
            <div class="item bi-focus-card">
              <img class="img-fluid" src={asset(capability.icon)} alt={capability.title} />
              <h3>{capability.title}</h3>
              <p>{capability.text}</p>
              <ul>
                {capability.points.map((point) => (
                  <li>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
      <div class="col-12 bi-primary-action">
        <a class="cta cta-secondary" href="/contact/">Discuss Requirements</a>
      </div>
    </section>

    <section class="sector bi-engagements row" id="typical-engagements">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
        <h2>Typical Engagements</h2>
        <p>
          We usually help where teams need practical reporting improvements without creating unnecessary platform
          complexity.
        </p>
        <ul>
          {typicalEngagements.map((engagement) => <li><span>{engagement}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="sector bi-supporting row" id="supporting-skills">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Supporting Skills</h2>
        </div>
        {
          supportingCapabilities.map((capability) => (
            <div class="col-12 col-sm-12 col-md-4 col-lg-4 col-xl-4 bi-supporting-item">
              <span class="bi-supporting-icon-wrap">
                {
                  capability.icon === 'bar-chart' ? (
                    <svg class="bi-supporting-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                      <rect class="bi-integration-mid" x="8" y="35" width="15" height="18" rx="1" />
                      <rect class="bi-integration-accent" x="27" y="23" width="15" height="30" rx="1" />
                      <rect class="bi-integration-dark" x="46" y="11" width="15" height="42" rx="1" />
                    </svg>
                  ) : capability.icon === 'integration' ? (
                    <svg
                      class="bi-supporting-icon"
                      aria-hidden="true"
                      focusable="false"
                      viewBox="0 0 64 64"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path class="bi-integration-accent" d="M8 9h20v20H8z" />
                      <path class="bi-integration-dark" d="M36 9h20v20H36z" />
                      <path class="bi-integration-mid" d="M8 37h20v20H8z" />
                      <path class="bi-integration-dark" d="M36 37h20v20H36z" />
                      <path
                        class="bi-integration-line"
                        d="M28 19h8M18 29v8M46 29v8M28 47h8"
                        fill="none"
                        stroke-linecap="round"
                        stroke-width="7"
                      />
                    </svg>
                  ) : capability.icon === 'report-laptop' ? (
                    <svg class="bi-supporting-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
                      <path
                        class="bi-integration-dark"
                        d="M12 12h40a5 5 0 0 1 5 5v31h-6V18H13v30H7V17a5 5 0 0 1 5-5Z"
                      />
                      <path class="bi-integration-mid" d="M3 47h24l2 4h6l2-4h24v4a7 7 0 0 1-7 7H10a7 7 0 0 1-7-7v-4Z" />
                      <rect class="bi-integration-accent" x="19" y="34" width="7" height="10" rx="1" />
                      <rect class="bi-integration-accent" x="30" y="24" width="7" height="20" rx="1" />
                      <rect class="bi-integration-accent" x="41" y="30" width="7" height="14" rx="1" />
                    </svg>
                  ) : (
                    <img class="bi-supporting-icon" src={asset(capability.icon)} alt={capability.title} />
                  )
                }
              </span>
              <h4>{capability.title}</h4>
              <p>
                <span>{capability.text}</span>
              </p>
            </div>
          ))
        }
      </div>
    </section>

    <ConversationCta
      title="Not confident your reporting is based on trusted data?"
      buttonText="Discuss a BI requirement"
    >
      <p>
        We can help review the data sources, reporting model and practical steps needed to make operational reporting
        more reliable.
      </p>
      <p>
        That may include Azure SQL, Dataverse, Power BI, legacy reporting tools, data integration or report governance.
      </p>
    </ConversationCta>

    <ExploreProjectsCta />

    <OtherServices currentPath="/services/business-intelligence/" />
  </div>
</BaseLayout>

<style>
  section.bi-primary,
  section.bi-supporting {
    padding-top: 3rem !important;
  }

  .bi-primary h2,
  .bi-supporting h2 {
    margin-bottom: 1.75rem;
  }

  section.solutions .bi-focus-card {
    min-height: auto;
    padding: 2rem;
  }

  section.solutions .bi-focus-card p:last-of-type {
    margin-bottom: 1.25rem;
  }

  section.solutions .bi-focus-card ul {
    margin-bottom: 0;
  }

  .bi-primary-action {
    margin-top: 0.5rem;
    text-align: center;
  }

  section.bi-supporting {
    margin-top: 1rem;
  }

  .bi-engagements ul {
    column-gap: 2rem;
    columns: 2;
    margin-top: 1rem;
  }

  .bi-hero-visual {
    display: block;
    height: auto;
    width: 100%;
  }

  @media (max-width: 991.98px) {
    section.maintained-service-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-service-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-service-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .bi-hero-visual {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-service-splash .header-text {
      font-size: 1.6em;
    }

    section.maintained-service-splash .cta {
      min-width: 0;
      width: 100%;
    }

    .bi-hero-visual {
      max-width: 13rem;
      width: 50%;
    }
  }

  .bi-visual-bg {
    fill: #e8f8fd;
  }

  .bi-visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .bi-visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .bi-visual-accent {
    fill: #8dd8f8;
  }

  .bi-visual-mid {
    fill: #00baf2;
  }

  .bi-visual-dark {
    fill: #0072bc;
  }

  .bi-visual-label {
    fill: #1d2733;
    font-family: Arial, sans-serif;
    font-size: 17px;
    font-weight: 700;
  }

  .owner-note {
    background: #fff59d;
    color: #7a5a00;
    display: inline;
    font-weight: 700;
    line-height: 1.5;
    padding: 0.1rem 0.25rem;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .bi-supporting-item {
    display: flex;
    flex-direction: column;
  }

  .bi-supporting-icon-wrap {
    display: flex;
    align-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 1rem;
  }

  section.bi-supporting .bi-supporting-icon-wrap .bi-supporting-icon {
    display: block !important;
    width: 4rem !important;
    height: 4rem !important;
    max-width: 4rem !important;
    max-height: 4rem !important;
    object-fit: contain !important;
    margin: 0 !important;
  }

  .bi-integration-accent {
    fill: #8dd8f8;
  }

  .bi-integration-mid {
    fill: #00baf2;
  }

  .bi-integration-dark {
    fill: #0072bc;
  }

  .bi-integration-line {
    stroke: #00baf2;
  }

  .bi-supporting-item h4 {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 767px) {
    .bi-engagements ul {
      columns: 1;
    }
  }
</style>
