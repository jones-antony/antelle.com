---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import OtherServices from '../../../components/OtherServices.astro';
import ExploreProjectsCta from '../../../components/ExploreProjectsCta.astro';

const asset = (path: string) => `/assets/${path}`;

const keyAreas = [
  'Short-term, temporary and fractional CTO support',
  'Microsoft CRM design and implementation',
  'Power Automate workflow design',
  'Dataverse data model and reporting advice',
  'Systems integration',
  'Business process review and re-engineering',
  'Database optimisation, sizing and capacity planning',
  'Microsoft Office automation and document generation',
  'Software development for small teams',
  'Requirements analysis and specification preparation',
  'Procurement projects where complex IT forms part of the brief'
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/services/consultancy/',
  areaServed: 'Isle of Man',
  serviceType: [
    'IT consultancy',
    'Microsoft technology consultancy',
    'Systems integration consultancy',
    'Fractional CTO support',
    'Temporary CTO support'
  ],
  description: 'Practical IT consultancy for Microsoft technology, systems integration and business process improvement.'
};
---

<BaseLayout
  title="Consultancy | Antelle IT Ltd"
  description="Practical Isle of Man IT consultancy from Antelle IT Ltd, covering Microsoft technology, systems integration, requirements analysis and business process improvement."
  pageClass="services"
  canonicalUrl="https://www.antelle.com/services/consultancy/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-service-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Consultancy</h1>
        <p class="header-text light">
          Practical technology advice for organisations planning system change, integration or Microsoft platform work.
        </p>
        <a href="/contact/" class="cta cta-large">Discuss a Consultancy Requirement</a>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg
          class="img-splash img-fluid consultancy-hero"
          viewBox="0 0 420 260"
          role="img"
          aria-labelledby="consultancy-hero-title consultancy-hero-desc"
          xmlns="http://www.w3.org/2000/svg"
        >
          <title id="consultancy-hero-title">Consultancy planning and technology advice</title>
          <desc id="consultancy-hero-desc">A planning board showing business requirements, technology options and delivery decisions.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />
          <path class="visual-line" d="M84 76h78M84 126h78M84 176h78M162 76c45 0 42 50 86 50h38M162 176c45 0 42-50 86-50h38" />
          <circle class="visual-mid" cx="70" cy="76" r="18" />
          <circle class="visual-accent" cx="70" cy="126" r="18" />
          <circle class="visual-dark" cx="70" cy="176" r="18" />
          <rect class="visual-dark" x="286" y="58" width="70" height="40" rx="4" />
          <rect class="visual-accent" x="286" y="108" width="70" height="40" rx="4" />
          <rect class="visual-mid" x="286" y="158" width="70" height="40" rx="4" />
          <path class="visual-tick" d="M307 78l10 10 20-22M307 128l10 10 20-22M307 178l10 10 20-22" />
        </svg>
      </div>
    </section>

    <section class="sector row" id="overview">
      <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 row">
        <div class="col-sub-header col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
          <h2>Overview</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <h3 class="header-2-text light">Useful advice starts with understanding the business problem.</h3>
          <p>
            Consultancy is most useful when it turns uncertainty into a clear next step. We help clients understand the
            business problem, assess realistic options and shape work that can be delivered and supported.
          </p>
          <p>
            Our consultancy work is focused on discovery, requirements, process review, Microsoft platform advice,
            integration planning and delivery preparation.
          </p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
          <p>
            We can help with early-stage requirements, system reviews, data and database concerns, supplier or procurement
            support, and the practical steps needed to move from idea to deliverable work.
          </p>
          <p>
            We can also provide short-term, temporary or fractional CTO support where an organisation needs experienced
            technology leadership for a defined period, a specific programme of change, or regular senior input into IT
            strategy and governance without appointing a full-time technology lead.
          </p>
        </div>
      </div>
    </section>

    <section class="solutions consultancy-approach service-card-grid row" id="our-approach">
      <div class="col-12">
        <h2>Our Approach</h2>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <div class="item service-focus-card">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <rect class="visual-panel" x="6" y="8" width="52" height="48" rx="5" />
            <path class="visual-line" d="M18 23h28M18 32h28M18 41h22" />
          </svg>
          <h3>Our Practice</h3>
          <p>
            Consultancy is more than knowing a subject. It is about asking the right questions, explaining trade-offs
            clearly and giving advice in a form that helps a client make a decision.
          </p>
          <p>
            We are direct about where we can help, where a delivery project needs more definition, and where another
            specialist would be a better fit.
          </p>
        </div>
      </div>
      <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
        <div class="item service-focus-card">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <rect class="visual-panel" x="8" y="10" width="48" height="42" rx="5" />
            <path class="visual-line" d="M20 24h24M20 34h16" />
            <circle class="visual-mid" cx="45" cy="41" r="8" />
            <path class="visual-tick" d="M41 41l3 3 7-9" />
          </svg>
          <h3>Short-Term and Fractional CTO Support</h3>
          <p>
            Some organisations need senior technology input before they need, or can justify, a permanent CTO. We can
            help with technology planning, delivery oversight, supplier conversations, risk review, governance and
            practical decision-making on a short-term, temporary or fractional basis. This can include regular
            participation in technology planning and steering discussions where independent, experienced advice is
            needed to keep IT activity aligned with business priorities.
          </p>
        </div>
      </div>
      <div class="col-12">
        <div class="item service-focus-card">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
            <rect class="visual-dark" x="7" y="8" width="22" height="22" rx="3" />
            <rect class="visual-accent" x="35" y="8" width="22" height="22" rx="3" />
            <rect class="visual-mid" x="7" y="36" width="22" height="22" rx="3" />
            <rect class="visual-dark" x="35" y="36" width="22" height="22" rx="3" />
          </svg>
          <h3>Key Areas</h3>
          <p>We are currently able to provide consulting services in the following key areas:</p>
          <ul>
            {keyAreas.map((area) => <li><span>{area}</span></li>)}
          </ul>
        </div>
      </div>
    </section>

    <ExploreProjectsCta />

    <OtherServices currentPath="/services/consultancy/" />
  </div>
</BaseLayout>

<style>
  .consultancy-hero,
  .section-icon,
  .content-icon {
    display: block;
    height: auto;
  }

  .consultancy-hero {
    width: 100%;
  }

  @media (max-width: 991.98px) {
    section.maintained-service-splash {
      min-height: auto;
      padding-bottom: 2rem !important;
      padding-top: 2.5rem !important;
    }

    section.maintained-service-splash > div:nth-of-type(1) {
      max-width: 100%;
      order: 2;
      position: static !important;
      width: 100% !important;
    }

    section.maintained-service-splash > div:nth-of-type(2) {
      margin-bottom: 0.75rem;
      max-width: 100%;
      opacity: 1;
      order: 1;
      position: static !important;
      text-align: right;
      width: 100% !important;
    }

    .consultancy-hero {
      display: inline-block;
      max-width: 20rem;
      width: 50%;
    }
  }

  @media (max-width: 576px) {
    section.maintained-service-splash .header-text {
      font-size: 1.6em;
    }

    section.maintained-service-splash .cta {
      min-width: 0;
      width: 100%;
    }

    .consultancy-hero {
      max-width: 13rem;
      width: 50%;
    }
  }

  .content-icon {
    height: 4rem;
    margin-bottom: 1rem;
    width: 4rem;
  }

  .approach-header-icon {
    align-items: center;
    display: inline-flex;
    justify-content: center;
  }

  .approach-header-icon .section-icon {
    margin: 0;
  }

  .section-icon {
    width: 4rem;
  }

  .service-card-grid {
    padding-top: 3rem !important;
  }

  .service-card-grid > div {
    margin-bottom: 2rem;
  }

  .service-focus-card {
    min-height: auto;
    padding: 2rem;
  }

  .service-focus-card p:last-of-type {
    margin-bottom: 0;
  }

  .visual-panel {
    fill: #ffffff;
    stroke: #8dd8f8;
    stroke-width: 2;
  }

  .visual-line {
    fill: none;
    stroke: #0072bc;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 5;
  }

  .visual-tick {
    fill: none;
    stroke: #ffffff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 6;
  }

  .visual-accent {
    fill: #8dd8f8;
  }

  .visual-mid {
    fill: #00baf2;
  }

  .visual-dark {
    fill: #0072bc;
  }
</style>
