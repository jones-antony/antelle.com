---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/services/microsoft-dynamics-crm/',
  areaServed: 'Isle of Man',
  serviceType: ['Microsoft Dynamics 365 consultancy', 'CRM implementation', 'Dataverse reporting'],
  description:
    'Microsoft Dynamics CRM and Dynamics 365 consultancy for practical CRM design, implementation, integration and support.'
};
---

<BaseLayout
  title="Microsoft Dynamics CRM | Antelle IT Ltd"
  description="Microsoft Dynamics CRM and Dynamics 365 consultancy from Antelle IT Ltd, covering CRM design, implementation, integration and support."
  pageClass="services"
  canonicalUrl="https://www.antelle.com/services/microsoft-dynamics-crm/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-service-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Microsoft Dynamics CRM</h1>
        <p class="header-text light">
          Practical Dynamics 365 and CRM support for relationship management, process design, integration and reporting.
        </p>
        <a href="/contact/" class="cta cta-large">Discuss a CRM Requirement</a>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg class="img-splash img-fluid crm-hero" viewBox="0 0 420 260" role="img" aria-labelledby="crm-hero-title crm-hero-desc" xmlns="http://www.w3.org/2000/svg">
          <title id="crm-hero-title">CRM relationships and reporting</title>
          <desc id="crm-hero-desc">Connected customer records, process stages and reporting indicators.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />
          <circle class="visual-dark" cx="98" cy="86" r="26" />
          <circle class="visual-accent" cx="98" cy="168" r="26" />
          <circle class="visual-mid" cx="252" cy="126" r="36" />
          <path class="visual-line" d="M124 86h74M124 168h74M198 86c30 0 26 40 54 40M198 168c30 0 26-42 54-42" />
          <rect class="visual-dark" x="302" y="70" width="64" height="112" rx="6" />
          <path class="visual-tick" d="M319 104l10 10 22-25M319 147l10 10 22-25" />
        </svg>
      </div>
    </section>

    <section class="overview row">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h2 class="light">Overview</h2>
        <p class="text-big">
          Dynamics 365 and Microsoft CRM work is most successful when the system reflects the way teams actually manage
          relationships, service activity, pipeline information and operational follow-up.
        </p>
        <p class="text-big">
          We can help with CRM design, implementation planning, customisation, integration, reporting and support for
          existing Dynamics estates.
        </p>
        <p class="owner-note">OWNER INPUT REQUIRED: confirm whether this page should refer to Dynamics 365, Microsoft Dynamics CRM, or both.</p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <div class="rectangle-graphic-bg"><span class="rectangle-graphic img-fluid"></span></div>
      </div>
    </section>

    <section class="sector row" id="key-areas">
      <div class="col-12 row">
        <div class="col-sub-header col-12">
          <span class="header-icon"><svg class="icon content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><circle class="visual-dark" cx="20" cy="22" r="11" /><circle class="visual-accent" cx="44" cy="22" r="11" /><path class="visual-line" d="M12 48c4-10 12-14 20-14s16 4 20 14" /></svg></span>
          <h2>Key Areas</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><rect class="visual-panel" x="8" y="10" width="48" height="44" rx="5" /><path class="visual-line" d="M18 24h28M18 34h18M18 44h24" /></svg>
          <h4>CRM Design</h4>
          <p>Process-led CRM design so entities, forms, views and data capture support real operational work.</p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><circle class="visual-mid" cx="16" cy="16" r="8" /><circle class="visual-accent" cx="48" cy="16" r="8" /><circle class="visual-dark" cx="32" cy="48" r="8" /><path class="visual-line" d="M24 16h16M21 22l9 18M43 22l-9 18" /></svg>
          <h4>Integration</h4>
          <p>Connecting CRM with Microsoft 365, Dataverse, reporting tools, databases and line-of-business systems.</p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><rect class="visual-mid" x="9" y="36" width="12" height="17" rx="1" /><rect class="visual-accent" x="26" y="26" width="12" height="27" rx="1" /><rect class="visual-dark" x="43" y="14" width="12" height="39" rx="1" /></svg>
          <h4>Reporting</h4>
          <p>Practical CRM and Dataverse reporting foundations, including operational measures and management views.</p>
        </div>
      </div>
    </section>

    <section class="sector row" id="delivery-approach">
      <div class="col-12">
        <h2>Delivery Approach</h2>
        <p>
          We start with the business process and data model, then shape the CRM configuration, integrations and reporting
          around the parts of the relationship lifecycle that need clearer control.
        </p>
        <p class="owner-note">OWNER INPUT REQUIRED: add approved Dynamics examples or remove this note before go live.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .crm-hero,.content-icon{display:block;height:auto}.crm-hero{width:100%}.content-icon{height:4rem;margin-bottom:1rem;width:4rem}.visual-panel{fill:#fff;stroke:#8dd8f8;stroke-width:2}.visual-line{fill:none;stroke:#0072bc;stroke-linecap:round;stroke-linejoin:round;stroke-width:5}.visual-tick{fill:none;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:6}.visual-accent{fill:#8dd8f8}.visual-mid{fill:#00baf2}.visual-dark{fill:#0072bc}.owner-note{background:#fff59d;color:#7a5a00;display:inline;font-weight:700;line-height:1.5;padding:.1rem .25rem;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  @media (max-width:991.98px){section.maintained-service-splash{min-height:auto;padding-bottom:2rem!important;padding-top:2.5rem!important}section.maintained-service-splash>div:nth-of-type(1){max-width:100%;order:2;position:static!important;width:100%!important}section.maintained-service-splash>div:nth-of-type(2){margin-bottom:.75rem;max-width:100%;opacity:1;order:1;position:static!important;text-align:right;width:100%!important}.crm-hero{display:inline-block;max-width:20rem;width:50%}}
  @media (max-width:576px){section.maintained-service-splash .header-text{font-size:1.6em}section.maintained-service-splash .cta{min-width:0;width:100%}.crm-hero{max-width:13rem;width:50%}}
</style>
