---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Antelle IT Ltd',
  url: 'https://www.antelle.com/services/software-development/',
  areaServed: 'Isle of Man',
  serviceType: ['Bespoke software development', 'Microsoft software development', 'Systems integration'],
  description:
    'Bespoke software development consultancy and delivery for Microsoft stack systems, integration and operational applications.'
};
---

<BaseLayout
  title="Software Development | Antelle IT Ltd"
  description="Bespoke software development from Antelle IT Ltd, covering Microsoft stack systems, integration and practical operational applications."
  pageClass="services"
  canonicalUrl="https://www.antelle.com/services/software-development/"
  structuredData={structuredData}
>
  <div class="container">
    <section class="splash row maintained-service-splash">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h1 class="subheader-text">Software Development</h1>
        <p class="header-text light">
          Bespoke Microsoft stack software for operational systems, integration and business processes that need a precise fit.
        </p>
        <a href="/contact/" class="cta cta-large">Discuss a Development Requirement</a>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <svg class="img-splash img-fluid software-hero" viewBox="0 0 420 260" role="img" aria-labelledby="software-hero-title software-hero-desc" xmlns="http://www.w3.org/2000/svg">
          <title id="software-hero-title">Software design and integration</title>
          <desc id="software-hero-desc">A software window with code, workflow blocks and connected systems.</desc>
          <rect class="visual-panel" x="18" y="18" width="384" height="224" rx="8" />
          <rect class="visual-dark" x="54" y="62" width="154" height="122" rx="6" />
          <path class="visual-code" d="M86 95l-22 22 22 22M176 95l22 22-22 22M121 149l26-64" />
          <rect class="visual-accent" x="250" y="64" width="94" height="40" rx="5" />
          <rect class="visual-mid" x="250" y="130" width="94" height="40" rx="5" />
          <path class="visual-line" d="M208 123h42M297 104v26" />
        </svg>
      </div>
    </section>

    <section class="overview row">
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <h2 class="light">Overview</h2>
        <p class="text-big">
          Bespoke software is useful where the business process, integration requirement or support model cannot be met
          well by an off-the-shelf product.
        </p>
        <p class="text-big">
          We focus on maintainable systems that solve defined operational problems and can be supported over the long
          term.
        </p>
        <p class="owner-note">OWNER INPUT REQUIRED: confirm the current software development stack and preferred wording before go live.</p>
      </div>
      <div class="col-12 col-sm-12 col-md-12 col-lg-6 col-xl-6">
        <div class="rectangle-graphic-bg"><span class="rectangle-graphic img-fluid"></span></div>
      </div>
    </section>

    <section class="sector row" id="key-areas">
      <div class="col-12 row">
        <div class="col-sub-header col-12">
          <span class="header-icon"><svg class="icon content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><rect class="visual-dark" x="8" y="12" width="48" height="40" rx="5" /><path class="visual-code" d="M25 25l-8 7 8 7M39 25l8 7-8 7" /></svg></span>
          <h2>Key Areas</h2>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><rect class="visual-panel" x="8" y="10" width="48" height="44" rx="5" /><path class="visual-line" d="M18 24h28M18 34h22M18 44h16" /></svg>
          <h4>Operational Applications</h4>
          <p>Custom applications for business processes that need controlled data capture, workflow and reporting.</p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><rect class="visual-dark" x="8" y="15" width="17" height="17" rx="3" /><rect class="visual-accent" x="39" y="15" width="17" height="17" rx="3" /><rect class="visual-mid" x="23" y="38" width="18" height="17" rx="3" /><path class="visual-line" d="M25 24h14M17 32l10 10M48 32L38 42" /></svg>
          <h4>Systems Integration</h4>
          <p>Connecting databases, APIs, Microsoft services and line-of-business systems so data moves reliably.</p>
        </div>
        <div class="col-12 col-sm-12 col-md-6 col-lg-4 col-xl-4">
          <svg class="content-icon" aria-hidden="true" focusable="false" viewBox="0 0 64 64"><path class="visual-dark" d="M32 7l22 9v13c0 14-9 25-22 29C19 54 10 43 10 29V16l22-9Z" /><path class="visual-tick" d="M22 32l7 7 15-18" /></svg>
          <h4>Supportable Delivery</h4>
          <p>Design and implementation choices that account for handover, hosting, security, documentation and long-term support.</p>
        </div>
      </div>
    </section>

    <section class="sector row" id="delivery-approach">
      <div class="col-12">
        <h2>Delivery Approach</h2>
        <p>
          We start by defining the problem, data model, integration points and support requirements. The delivery shape
          should then follow the business need rather than a fixed product preference.
        </p>
        <p class="owner-note">OWNER INPUT REQUIRED: add approved project examples and current technology list.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .software-hero,.content-icon{display:block;height:auto}.software-hero{width:100%}.content-icon{height:4rem;margin-bottom:1rem;width:4rem}.visual-panel{fill:#fff;stroke:#8dd8f8;stroke-width:2}.visual-line{fill:none;stroke:#0072bc;stroke-linecap:round;stroke-linejoin:round;stroke-width:5}.visual-code{fill:none;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:6}.visual-tick{fill:none;stroke:#fff;stroke-linecap:round;stroke-linejoin:round;stroke-width:6}.visual-accent{fill:#8dd8f8}.visual-mid{fill:#00baf2}.visual-dark{fill:#0072bc}.owner-note{background:#fff59d;color:#7a5a00;display:inline;font-weight:700;line-height:1.5;padding:.1rem .25rem;box-decoration-break:clone;-webkit-box-decoration-break:clone}
  @media (max-width:991.98px){section.maintained-service-splash{min-height:auto;padding-bottom:2rem!important;padding-top:2.5rem!important}section.maintained-service-splash>div:nth-of-type(1){max-width:100%;order:2;position:static!important;width:100%!important}section.maintained-service-splash>div:nth-of-type(2){margin-bottom:.75rem;max-width:100%;opacity:1;order:1;position:static!important;text-align:right;width:100%!important}.software-hero{display:inline-block;max-width:20rem;width:50%}}
  @media (max-width:576px){section.maintained-service-splash .header-text{font-size:1.6em}section.maintained-service-splash .cta{min-width:0;width:100%}.software-hero{max-width:13rem;width:50%}}
</style>
